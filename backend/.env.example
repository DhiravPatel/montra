# Montra backend configuration (copy to .env.local for development; hosted
# environments inject these via their secret manager). Placeholders only —
# never commit real values. Generate keys with: openssl rand -base64 32

# --- environment
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=info
LOG_FORMAT=json                     # json | text
APP_VERSION=0.1.0-dev

# --- HTTP
HTTP_ADDR=:8080
PUBLIC_API_BASE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
HTTP_TRUST_PROXY_HEADERS=false      # true only behind a trusted proxy/load balancer
HTTP_ENABLE_DOCS=false              # serves /api/v1/docs + /api/v1/openapi.json when true
METRICS_TOKEN=                      # optional bearer token for /metrics

# --- database (runtime roles; RLS enforced)
DATABASE_URL=postgres://montra_app:CHANGE_ME@localhost:5432/montra_dev?sslmode=disable
WORKER_DATABASE_URL=postgres://montra_worker:CHANGE_ME@localhost:5432/montra_dev?sslmode=disable
DATABASE_MIGRATION_URL=postgres://montra_owner:CHANGE_ME@localhost:5432/montra_dev?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_SIMPLE_PROTOCOL=false      # true when using a transaction-mode pooler

# --- integration tests (database name MUST end in _test)
TEST_DATABASE_MIGRATION_URL=postgres://montra_owner:CHANGE_ME@localhost:5432/montra_test?sslmode=disable
TEST_DATABASE_APP_URL=postgres://montra_app:CHANGE_ME@localhost:5432/montra_test?sslmode=disable
TEST_DATABASE_WORKER_URL=postgres://montra_worker:CHANGE_ME@localhost:5432/montra_test?sslmode=disable

# --- keys (base64, 32 bytes)
DATA_ENCRYPTION_KEYS=k1:BASE64_32_BYTE_KEY   # comma-separated keyring; first key encrypts
URL_SIGNING_KEY=BASE64_32_BYTE_KEY

# --- auth
AUTH_COOKIE_SECURE=true             # must be true outside development
AUTH_COOKIE_DOMAIN=                 # e.g. .montra.example when web and API share a parent domain
AUTH_REQUIRE_EMAIL_VERIFIED=true      # must be true outside development and test
AUTH_DEV_AUTO_VERIFY_EMAIL=false      # development only: true skips email verification (accounts verified at sign-up/sign-in); refused unless APP_ENV=development
AUTH_DEV_RATE_PER_MINUTE=0           # development/test only: per-IP sign-in/sign-up limit for local e2e runs (0 = default ~10/min); refused elsewhere
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_REFRESH_ABSOLUTE_TTL=2160h
AUTH_LOGIN_MAX_FAILURES=5
AUTH_MINIMUM_AGE_YEARS=18
TURNSTILE_SECRET_KEY=               # optional bot protection (Cloudflare Turnstile)

# --- storage (ADR-009/010). local_disk is development-only and is NOT Appwrite.
STORAGE_PROVIDER=local_disk         # appwrite | local_disk | disabled
STORAGE_LOCAL_DIR=.data/storage
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_PRIVATE=private-user-docs
APPWRITE_BUCKET_GROUP=group-docs
APPWRITE_BUCKET_PUBLIC_MEDIA=public-media
APPWRITE_BUCKET_TEMP=temp-processing
APPWRITE_BUCKET_EXPORTS=exports

# --- email (ADR-014). dev_mailbox writes .eml files and is development-only.
EMAIL_PROVIDER=dev_mailbox          # smtp | dev_mailbox | disabled
EMAIL_FROM=Montra <no-reply@montra.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEV_MAIL_DIR=.data/mail

# --- push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@montra.example
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# --- AI (ADR-012); disabled means deterministic, provider-free mode
AI_PROVIDER=disabled                # anthropic | disabled
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- FX (ADR-015)
FX_PROVIDER=manual                  # manual | ecb

# --- worker
WORKER_CONCURRENCY=4
WORKER_SCHEDULER_ENABLED=true
WORKER_METRICS_ADDR=127.0.0.1:9091

# --- product
SUPPORT_EMAIL=support@montra.example
SECURITY_EMAIL=security@montra.example
DEFAULT_LOCALE=en-IN
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
