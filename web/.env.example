# Montra web portal environment. Copy to `.env.local` for local overrides.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so
# never put secrets in them (there are none: the web client holds no keys).

# Base URL of the Montra API, as seen by the browser.
#  - Default (recommended): same-origin path `/api/v1`. In development the
#    Vite dev server proxies /api to the Go API, so session cookies are
#    first-party. In production, serve the API from the same site.
#  - Absolute URL (e.g. https://api.montra.example/api/v1): its origin must
#    also be listed in the CSP `connect-src` in vercel.json (the build
#    fails otherwise) and in the API's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Contact addresses shown on public pages (placeholders until the owner
# sets real ones; see docs/DECISIONS.md ADR-024).
VITE_SUPPORT_EMAIL=support@montra.example
VITE_SECURITY_EMAIL=security@montra.example

# Optional public service-status page (https). When set, help and the
# troubleshooting guide link to it; when empty there is no status link.
VITE_STATUS_PAGE_URL=

# Development only (not exposed to the browser): where `pnpm dev` and
# `pnpm preview` proxy /api requests.
MONTRA_API_PROXY_TARGET=http://localhost:8080
