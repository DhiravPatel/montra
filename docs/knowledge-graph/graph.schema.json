{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://montra.local/docs/knowledge-graph/graph.schema.json",
 "title": "Montra knowledge graph",
 "description": "Generated by scripts/docs/gen_knowledge_graph.py. Node and edge types are closed lists; see docs/KNOWLEDGE_GRAPH.md for definitions.",
 "type": "object",
 "required": [
  "schema_version",
  "generated_from",
  "counts",
  "nodes",
  "edges"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "generated_at": {
   "type": "string",
   "description": "Only with --stamp."
  },
  "generated_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "counts": {
   "type": "object",
   "required": [
    "nodes",
    "edges",
    "node_types",
    "edge_types"
   ],
   "properties": {
    "nodes": {
     "type": "integer",
     "minimum": 0
    },
    "edges": {
     "type": "integer",
     "minimum": 0
    },
    "node_types": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "app",
       "decision",
       "doc",
       "event",
       "feature",
       "job",
       "migration",
       "mobile_feature",
       "mobile_route",
       "operation",
       "package",
       "requirement",
       "table",
       "web_feature",
       "web_route"
      ]
     },
     "additionalProperties": {
      "type": "integer"
     }
    },
    "edge_types": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "alters",
       "belongs_to",
       "calls",
       "created_in",
       "depends_on",
       "documented_in",
       "emits",
       "enqueues",
       "handled_by",
       "handled_in",
       "implemented_in",
       "includes",
       "links_to",
       "located_in",
       "part_of",
       "reads",
       "references",
       "triggers",
       "writes"
      ]
     },
     "additionalProperties": {
      "type": "integer"
     }
    }
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/node"
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/edge"
   }
  }
 },
 "$defs": {
  "node": {
   "type": "object",
   "required": [
    "id",
    "type",
    "label",
    "props"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^(app:|adr:|doc:|event:|feature:|job:|migration:|mobile:|mobileroute:|op:|pkg:|req:|table:|web:|webroute:).+$"
    },
    "type": {
     "enum": [
      "app",
      "decision",
      "doc",
      "event",
      "feature",
      "job",
      "migration",
      "mobile_feature",
      "mobile_route",
      "operation",
      "package",
      "requirement",
      "table",
      "web_feature",
      "web_route"
     ]
    },
    "label": {
     "type": "string"
    },
    "props": {
     "type": "object"
    }
   }
  },
  "edge": {
   "type": "object",
   "required": [
    "source",
    "target",
    "type",
    "props"
   ],
   "additionalProperties": false,
   "properties": {
    "source": {
     "type": "string",
     "pattern": "^(app:|adr:|doc:|event:|feature:|job:|migration:|mobile:|mobileroute:|op:|pkg:|req:|table:|web:|webroute:).+$"
    },
    "target": {
     "type": "string",
     "pattern": "^(app:|adr:|doc:|event:|feature:|job:|migration:|mobile:|mobileroute:|op:|pkg:|req:|table:|web:|webroute:).+$"
    },
    "type": {
     "enum": [
      "alters",
      "belongs_to",
      "calls",
      "created_in",
      "depends_on",
      "documented_in",
      "emits",
      "enqueues",
      "handled_by",
      "handled_in",
      "implemented_in",
      "includes",
      "links_to",
      "located_in",
      "part_of",
      "reads",
      "references",
      "triggers",
      "writes"
     ]
    },
    "props": {
     "type": "object"
    }
   }
  }
 }
}
