{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://montra.local/docs/knowledge-graph/graph.schema.json",
 "title": "Montra knowledge graph",
 "description": "Generated by scripts/docs/gen_knowledge_graph.py. Node and edge types are closed lists; see docs/KNOWLEDGE_GRAPH.md for definitions.",
 "type": "object",
 "required": [
  "schema_version",
  "generated_from",
  "counts",
  "nodes",
  "edges"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "generated_at": {
   "type": "string",
   "description": "Only with --stamp."
  },
  "generated_from": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "counts": {
   "type": "object",
   "required": [
    "nodes",
    "edges",
    "node_types",
    "edge_types"
   ],
   "properties": {
    "nodes": {
     "type": "integer",
     "minimum": 0
    },
    "edges": {
     "type": "integer",
     "minimum": 0
    },
    "node_types": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "app",
       "ci_job",
       "config",
       "decision",
       "doc",
       "error_code",
       "event",
       "feature",
       "flow",
       "job",
       "make_target",
       "migration",
       "mobile_feature",
       "mobile_route",
       "notification_type",
       "operation",
       "package",
       "policy",
       "provider",
       "requirement",
       "sql_function",
       "step",
       "table",
       "test",
       "web_feature",
       "web_route",
       "workflow"
      ]
     },
     "additionalProperties": {
      "type": "integer"
     }
    },
    "edge_types": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "alters",
       "belongs_to",
       "calls",
       "checks",
       "configured_by",
       "configures",
       "covers",
       "created_in",
       "defined_in",
       "defines",
       "depends_on",
       "documented_in",
       "emits",
       "enqueues",
       "handled_by",
       "handled_in",
       "has_step",
       "implemented_in",
       "includes",
       "integrates",
       "involves",
       "links_to",
       "located_in",
       "mirrors",
       "next",
       "opens",
       "part_of",
       "protects",
       "raises",
       "reads",
       "redefines",
       "redirects_to",
       "references",
       "runs",
       "sends",
       "shown_on",
       "triggers",
       "uses",
       "verified_by",
       "verifies",
       "writes"
      ]
     },
     "additionalProperties": {
      "type": "integer"
     }
    }
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/node"
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/edge"
   }
  }
 },
 "$defs": {
  "node": {
   "type": "object",
   "required": [
    "id",
    "type",
    "label",
    "props"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^(app:|ci:|config:|adr:|doc:|err:|event:|feature:|flow:|job:|make:|migration:|mobile:|mobileroute:|notif:|op:|pkg:|policy:|provider:|req:|fn:|step:|table:|test:|web:|webroute:|workflow:).+$"
    },
    "type": {
     "enum": [
      "app",
      "ci_job",
      "config",
      "decision",
      "doc",
      "error_code",
      "event",
      "feature",
      "flow",
      "job",
      "make_target",
      "migration",
      "mobile_feature",
      "mobile_route",
      "notification_type",
      "operation",
      "package",
      "policy",
      "provider",
      "requirement",
      "sql_function",
      "step",
      "table",
      "test",
      "web_feature",
      "web_route",
      "workflow"
     ]
    },
    "label": {
     "type": "string"
    },
    "props": {
     "type": "object"
    }
   }
  },
  "edge": {
   "type": "object",
   "required": [
    "source",
    "target",
    "type",
    "props"
   ],
   "additionalProperties": false,
   "properties": {
    "source": {
     "type": "string",
     "pattern": "^(app:|ci:|config:|adr:|doc:|err:|event:|feature:|flow:|job:|make:|migration:|mobile:|mobileroute:|notif:|op:|pkg:|policy:|provider:|req:|fn:|step:|table:|test:|web:|webroute:|workflow:).+$"
    },
    "target": {
     "type": "string",
     "pattern": "^(app:|ci:|config:|adr:|doc:|err:|event:|feature:|flow:|job:|make:|migration:|mobile:|mobileroute:|notif:|op:|pkg:|policy:|provider:|req:|fn:|step:|table:|test:|web:|webroute:|workflow:).+$"
    },
    "type": {
     "enum": [
      "alters",
      "belongs_to",
      "calls",
      "checks",
      "configured_by",
      "configures",
      "covers",
      "created_in",
      "defined_in",
      "defines",
      "depends_on",
      "documented_in",
      "emits",
      "enqueues",
      "handled_by",
      "handled_in",
      "has_step",
      "implemented_in",
      "includes",
      "integrates",
      "involves",
      "links_to",
      "located_in",
      "mirrors",
      "next",
      "opens",
      "part_of",
      "protects",
      "raises",
      "reads",
      "redefines",
      "redirects_to",
      "references",
      "runs",
      "sends",
      "shown_on",
      "triggers",
      "uses",
      "verified_by",
      "verifies",
      "writes"
     ]
    },
    "props": {
     "type": "object"
    }
   }
  }
 }
}
