  {`id`: 'config:AUTH_PASSWORD_RESET_TTL', `props`: {`field`: 'Auth.PasswordResetTTL', `label`: 'AUTH_PASSWORD_RESET_TTL', `loader`: 'duration', `type`: 'config'}},
