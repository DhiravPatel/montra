// Montra knowledge graph: Neo4j import generated by scripts/docs/gen_knowledge_graph.py.
// Idempotent (MERGE). Run with: cypher-shell -f docs/knowledge-graph/graph.cypher
// Every node also carries the :Entity label so edges can MATCH on one indexed id.
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
UNWIND [
  {`id`: 'app:backend', `props`: {`label`: 'Go API + worker (backend/)', `type`: 'app'}},
  {`id`: 'app:contract', `props`: {`label`: 'OpenAPI contract (contracts/openapi)', `type`: 'app'}},
  {`id`: 'app:database', `props`: {`label`: 'Postgres schema and RLS (supabase/migrations)', `type`: 'app'}},
  {`id`: 'app:docs', `props`: {`label`: 'Documentation (docs/)', `type`: 'app'}},
  {`id`: 'app:mobile', `props`: {`label`: 'Flutter app (mobile/)', `type`: 'app'}},
  {`id`: 'app:repo', `props`: {`label`: 'Repository tooling: Makefile, scripts, CI, READMEs, env templates', `type`: 'app'}},
  {`id`: 'app:web', `props`: {`label`: 'React web portal (web/)', `type`: 'app'}}
] AS row
MERGE (n:Entity {id: row.id})
SET n:App, n += row.props;
UNWIND [
  {`id`: 'ci:ci/backend', `props`: {`label`: 'ci / backend', `steps`: ['Create CI roles and database (mirrors scripts/db/bootstrap.sh)', 'gofmt', 'vet', 'golangci-lint', 'sqlc generated code is current', 'Contract drift check', 'Error-code tables in docs/API.md are current', 'Knowledge graph parser tests', 'Knowledge graph (docs/knowledge-graph, docs/KNOWLEDGE_GRAPH.md) is current', 'Unit tests (race)', 'Integration + RLS + API tests', 'Short fuzz', 'govulncheck', 'Build binaries', 'Build container image (local only, never pushed)'], `type`: 'ci_job'}},
  {`id`: 'ci:ci/changes', `props`: {`label`: 'ci / changes', `type`: 'ci_job'}},
  {`id`: 'ci:ci/mobile', `props`: {`label`: 'ci / mobile', `type`: 'ci_job'}},
  {`id`: 'ci:ci/no-paywall', `props`: {`label`: 'ci / no-paywall', `steps`: ['Reject paid-tier code paths (spec §17)'], `type`: 'ci_job'}},
  {`id`: 'ci:ci/secrets-scan', `props`: {`label`: 'ci / secrets-scan', `type`: 'ci_job'}},
  {`id`: 'ci:ci/web', `props`: {`label`: 'ci / web', `type`: 'ci_job'}},
  {`id`: 'ci:e2e/changes', `props`: {`label`: 'e2e / changes', `type`: 'ci_job'}},
  {`id`: 'ci:e2e/mobile-e2e', `props`: {`label`: 'e2e / mobile-e2e', `steps`: ['Start throwaway API + worker', 'Enable KVM for the Android emulator', 'Flutter dependencies', 'Integration tests on the emulator', 'Upload API and worker logs', 'Stop API + worker'], `type`: 'ci_job'}},
  {`id`: 'ci:e2e/web-e2e', `props`: {`label`: 'e2e / web-e2e', `steps`: ['Start throwaway API + worker', 'Install web dependencies', 'Install Playwright Chromium', 'Playwright journeys (desktop, phone, tablet)', 'Upload Playwright report and traces', 'Upload API and worker logs', 'Stop API + worker'], `type`: 'ci_job'}}
] AS row
MERGE (n:Entity {id: row.id})
SET n:CiJob, n += row.props;
UNWIND [
  {`id`: 'config:AI_DAILY_REQUEST_CAP_PER_USER', `props`: {`field`: 'AI.DailyRequestCap', `label`: 'AI_DAILY_REQUEST_CAP_PER_USER', `loader`: 'integer', `type`: 'config'}},
  {`id`: 'config:AI_MAX_OUTPUT_TOKENS', `props`: {`field`: 'AI.MaxOutputTokens', `label`: 'AI_MAX_OUTPUT_TOKENS', `loader`: 'integer', `type`: 'config'}},
  {`id`: 'config:AI_MODEL', `props`: {`field`: 'AI.Model', `label`: 'AI_MODEL', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:AI_PROVIDER', `props`: {`field`: 'AI.Provider', `label`: 'AI_PROVIDER', `loader`: 'str', `type`: 'config', `validation`: ['AI_PROVIDER=anthropic requires ANTHROPIC_API_KEY', 'AI_PROVIDER must be anthropic or disabled']}},
  {`id`: 'config:AI_TIMEOUT', `props`: {`field`: 'AI.Timeout', `label`: 'AI_TIMEOUT', `loader`: 'duration', `type`: 'config'}},
  {`id`: 'config:AI_VISION_MODEL', `props`: {`field`: 'AI.VisionModel', `label`: 'AI_VISION_MODEL', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:ANTHROPIC_API_KEY', `props`: {`field`: 'AI.APIKey', `label`: 'ANTHROPIC_API_KEY', `loader`: 'str', `required_when`: ['AI_PROVIDER=anthropic'], `secret`: true, `type`: 'config', `validation`: ['AI_PROVIDER=anthropic requires ANTHROPIC_API_KEY']}},
  {`id`: 'config:APPWRITE_API_KEY', `props`: {`field`: 'Storage.AppwriteAPIKey', `label`: 'APPWRITE_API_KEY', `loader`: 'str', `required_when`: ['STORAGE_PROVIDER=appwrite'], `secret`: true, `type`: 'config', `validation`: ['STORAGE_PROVIDER=appwrite requires APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID and APPWRITE_API_KEY']}},
  {`id`: 'config:APPWRITE_BUCKET_EXPORTS', `props`: {`field`: 'Storage.Buckets.Exports', `label`: 'APPWRITE_BUCKET_EXPORTS', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:APPWRITE_BUCKET_GROUP', `props`: {`field`: 'Storage.Buckets.Group', `label`: 'APPWRITE_BUCKET_GROUP', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:APPWRITE_BUCKET_PRIVATE', `props`: {`field`: 'Storage.Buckets.PrivateUser', `label`: 'APPWRITE_BUCKET_PRIVATE', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:APPWRITE_BUCKET_PUBLIC_MEDIA', `props`: {`field`: 'Storage.Buckets.PublicMedia', `label`: 'APPWRITE_BUCKET_PUBLIC_MEDIA', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:APPWRITE_BUCKET_TEMP', `props`: {`field`: 'Storage.Buckets.Temp', `label`: 'APPWRITE_BUCKET_TEMP', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:APPWRITE_ENDPOINT', `props`: {`field`: 'Storage.AppwriteEndpoint', `label`: 'APPWRITE_ENDPOINT', `loader`: 'str', `required_when`: ['STORAGE_PROVIDER=appwrite'], `type`: 'config', `validation`: ['STORAGE_PROVIDER=appwrite requires APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID and APPWRITE_API_KEY', 'APPWRITE_ENDPOINT must be an https URL']}},
  {`id`: 'config:APPWRITE_PROJECT_ID', `props`: {`field`: 'Storage.AppwriteProjectID', `label`: 'APPWRITE_PROJECT_ID', `loader`: 'str', `required_when`: ['STORAGE_PROVIDER=appwrite'], `type`: 'config', `validation`: ['STORAGE_PROVIDER=appwrite requires APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID and APPWRITE_API_KEY']}},
  {`id`: 'config:APPWRITE_TIMEOUT', `props`: {`field`: 'Storage.AppwriteTimeout', `label`: 'APPWRITE_TIMEOUT', `loader`: 'duration', `type`: 'config'}},
  {`id`: 'config:APP_ENV', `props`: {`field`: 'Env', `label`: 'APP_ENV', `loader`: 'str', `type`: 'config', `validation`: ['APP_ENV must be one of development, test, staging, production', 'STORAGE_PROVIDER=local_disk is only allowed when APP_ENV is development or test', 'EMAIL_PROVIDER=dev_mailbox is only allowed when APP_ENV is development or test', 'AUTH_DEV_RATE_PER_MINUTE is only allowed when APP_ENV is development or test', 'AUTH_DEV_AUTO_VERIFY_EMAIL=true is only allowed when APP_ENV=development']}},
  {`id`: 'config:APP_VERSION', `props`: {`field`: 'Version', `label`: 'APP_VERSION', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:AUTH_ACCESS_TOKEN_TTL', `props`: {`field`: 'Auth.AccessTokenTTL', `label`: 'AUTH_ACCESS_TOKEN_TTL', `loader`: 'duration', `type`: 'config'}},
  {`id`: 'config:AUTH_ALLOW_REGISTRATION', `props`: {`field`: 'Auth.AllowRegistration', `label`: 'AUTH_ALLOW_REGISTRATION', `loader`: 'boolean', `type`: 'config'}},
  {`id`: 'config:AUTH_COOKIE_DOMAIN', `props`: {`field`: 'Auth.CookieDomain', `label`: 'AUTH_COOKIE_DOMAIN', `loader`: 'str', `type`: 'config'}},
  {`id`: 'config:AUTH_COOKIE_SECURE', `props`: {`field`: 'Auth.CookieSecure', `label`: 'AUTH_COOKIE_SECURE', `loader`: 'boolean', `type`: 'config', `validation`: ['AUTH_COOKIE_SECURE must be true outside development']}},
  {`id`: 'config:AUTH_DEV_AUTO_VERIFY_EMAIL', `props`: {`dev_only_values`: ['true'], `field`: 'Auth.DevAutoVerifyEmail', `label`: 'AUTH_DEV_AUTO_VERIFY_EMAIL', `loader`: 'boolean', `type`: 'config', `validation`: ['AUTH_DEV_AUTO_VERIFY_EMAIL=true is only allowed when APP_ENV=development']}},
  {`id`: 'config:AUTH_DEV_RATE_PER_MINUTE', `props`: {`dev_only`: true, `field`: 'Auth.DevAuthRatePerMinute', `label`: 'AUTH_DEV_RATE_PER_MINUTE', `loader`: 'integer', `type`: 'config', `validation`: ['AUTH_DEV_RATE_PER_MINUTE is only allowed when APP_ENV is development or test', 'AUTH_DEV_RATE_PER_MINUTE must be between 0 and 6000']}},
  {`id`: 'config:AUTH_EMAIL_VERIFICATION_TTL', `props`: {`field`: 'Auth.EmailVerificationTTL', `label`: 'AUTH_EMAIL_VERIFICATION_TTL', `loader`: 'duration', `type`: 'config'}},
  {`id`: 'config:AUTH_LOGIN_FAILURE_WINDOW', `props`: {`field`: 'Auth.LoginFailureWindow', `label`: 'AUTH_LOGIN_FAILURE_WINDOW', `loader`: 'duration', `type`: 'config'}},
  {`id`: 'config:AUTH_LOGIN_LOCKOUT', `props`: {`field`: 'Auth.LoginLockoutDuration', `label`: 'AUTH_LOGIN_LOCKOUT', `loader`: 'duration', `type`: 'config'}},
