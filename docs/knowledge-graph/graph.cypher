UNWIND [
  {`id`: 'make:api', `props`: {`help`: 'Run the Go API on :8080', `label`: 'make api', `recipe`: ['cd backend && go run ./cmd/api'], `type`: 'make_target'}},
  {`id`: 'make:build-backend', `props`: {`help`: 'Build api, worker and migrate binaries', `label`: 'make build-backend', `recipe`: ['cd backend && CGO_ENABLED=0 go build -trimpath -o bin/api ./cmd/api && CGO_ENABLED=0 go build -trimpath -o bin/worker ./cmd/worker && CGO_ENABLED=0 go build -trimpath -o bin/migrate ./cmd/migrate'], `type`: 'make_target'}},
  {`id`: 'make:check', `props`: {`help`: 'Everything CI runs', `label`: 'make check', `type`: 'make_target'}},
  {`id`: 'make:contract', `props`: {`help`: 'Regenerate contracts/openapi/montra.v1.json from the Go API', `label`: 'make contract', `recipe`: ['cd backend && go run ./cmd/openapi -out ../contracts/openapi/montra.v1.json'], `type`: 'make_target'}},
  {`id`: 'make:contract-check', `props`: {`help`: 'Fail if the committed contract is out of date', `label`: 'make contract-check', `recipe`: ['cd backend && go run ./cmd/openapi -check -out ../contracts/openapi/montra.v1.json'], `type`: 'make_target'}},
  {`id`: 'make:db-bootstrap', `props`: {`help`: 'Create Montra roles + montra_dev/montra_test on the EXISTING local PostgreSQL (prints target first)', `label`: 'make db-bootstrap', `recipe`: ['./scripts/db/bootstrap.sh'], `type`: 'make_target'}},
  {`id`: 'make:db-reset-dev', `props`: {`help`: 'DESTRUCTIVE for montra_dev only: drop schema montra and re-migrate (asks for confirmation)', `label`: 'make db-reset-dev', `recipe`: ['@read -p "Type montra_dev to confirm reset of schema montra in montra_dev: " c; cd backend && go run ./cmd/migrate reset -confirm $$c'], `type`: 'make_target'}},
  {`id`: 'make:docs', `props`: {`help`: 'Regenerate generated docs (error-code tables in docs/API.md, knowledge graph in docs/knowledge-graph)', `label`: 'make docs', `recipe`: ['python3 scripts/docs/gen_error_codes.py', 'python3 scripts/docs/gen_knowledge_graph.py'], `type`: 'make_target'}},
  {`id`: 'make:docs-check', `props`: {`help`: 'Fail if generated docs are out of date (error codes, knowledge graph + its parser tests)', `label`: 'make docs-check', `recipe`: ['python3 scripts/docs/gen_error_codes.py --check', 'python3 -B -m unittest scripts/docs/test_gen_knowledge_graph.py', 'python3 scripts/docs/gen_knowledge_graph.py --check'], `type`: 'make_target'}},
  {`id`: 'make:e2e', `props`: {`help`: 'Playwright journeys, all three projects (starts Vite on :5199; API via MONTRA_API_PROXY_TARGET, default :8080)', `label`: 'make e2e', `recipe`: ['cd web && pnpm e2e'], `type`: 'make_target'}},
  {`id`: 'make:e2e-mobile', `props`: {`help`: 'Flutter integration_test journeys on the running Android emulator against the API on :8080 (keeps the app installed)', `label`: 'make e2e-mobile', `recipe`: ['cd mobile && $(FLUTTER) test integration_test --no-uninstall --dart-define=API_BASE_URL=http://10.0.2.2:8080'], `type`: 'make_target'}},
  {`id`: 'make:fmt', `props`: {`help`: 'Format Go code', `label`: 'make fmt', `recipe`: ['cd backend && gofmt -w ./cmd ./internal ./tests'], `type`: 'make_target'}},
  {`id`: 'make:fuzz', `props`: {`help`: 'Short fuzz run for money and split allocation', `label`: 'make fuzz', `recipe`: ['cd backend && go test ./internal/domain/money -run=^$$ -fuzz=FuzzParseFormatRoundTrip -fuzztime=20s', 'cd backend && go test ./internal/domain/split -run=^$$ -fuzz=FuzzByWeights -fuzztime=20s'], `type`: 'make_target'}},
  {`id`: 'make:gen-mobile-api', `props`: {`help`: 'Regenerate Dart models from the contract', `label`: 'make gen-mobile-api', `recipe`: ['cd mobile && dart run tool/gen_api.dart'], `type`: 'make_target'}},
  {`id`: 'make:gen-web-api', `props`: {`help`: 'Regenerate TypeScript API types from the contract', `label`: 'make gen-web-api', `recipe`: ['cd web && pnpm gen:api'], `type`: 'make_target'}},
  {`id`: 'make:help', `props`: {`help`: 'Show this help', `label`: 'make help', `recipe`: ['@grep -E \'^[a-zA-Z0-9_-]+:.*?## \' $(MAKEFILE_LIST) | awk \'BEGIN {FS = ":.*?## "}; {printf "  \\033[36m%-20s\\033[0m %s\\n", $$1, $$2}\''], `type`: 'make_target'}},
  {`id`: 'make:lint', `props`: {`help`: 'Lint Go code', `label`: 'make lint', `recipe`: ['cd backend && go vet ./... && $(GOLANGCI) run ./...'], `type`: 'make_target'}},
  {`id`: 'make:load-test', `props`: {`help`: 'Local load test against the dev API (refuses non-local targets; never production)', `label`: 'make load-test', `recipe`: ['cd backend && go run ./cmd/loadtest -users 10 -duration 60s -rate 2'], `type`: 'make_target'}},
  {`id`: 'make:migrate', `props`: {`help`: 'Apply migrations to montra_dev (prints target first)', `label`: 'make migrate', `recipe`: ['cd backend && go run ./cmd/migrate up'], `type`: 'make_target'}},
  {`id`: 'make:migrate-status', `props`: {`help`: 'Show migration status for montra_dev', `label`: 'make migrate-status', `recipe`: ['cd backend && go run ./cmd/migrate status'], `type`: 'make_target'}},
  {`id`: 'make:migrate-test', `props`: {`help`: 'Apply migrations to montra_test', `label`: 'make migrate-test', `recipe`: ['cd backend && set -a && . ./.env.local && set +a && go run ./cmd/migrate up -url "$$TEST_DATABASE_MIGRATION_URL"'], `type`: 'make_target'}},
  {`id`: 'make:mobile', `props`: {`help`: 'Run the Flutter app on the Android emulator (reaches the host API at 10.0.2.2; the app adds /api/v1)', `label`: 'make mobile', `recipe`: ['cd mobile && $(FLUTTER) run --dart-define=API_BASE_URL=http://10.0.2.2:8080'], `type`: 'make_target'}},
  {`id`: 'make:mobile-analyze', `props`: {`help`: 'Flutter static analysis', `label`: 'make mobile-analyze', `recipe`: ['cd mobile && $(FLUTTER) analyze'], `type`: 'make_target'}},
  {`id`: 'make:mobile-test', `props`: {`help`: 'Flutter tests', `label`: 'make mobile-test', `recipe`: ['cd mobile && $(FLUTTER) test'], `type`: 'make_target'}},
  {`id`: 'make:seed', `props`: {`help`: 'Load deterministic synthetic seed data into montra_dev', `label`: 'make seed', `recipe`: ['cd backend && go run ./cmd/migrate seed'], `type`: 'make_target'}},
  {`id`: 'make:sqlc', `props`: {`help`: 'Regenerate sqlc query code from backend/internal/store/queries', `label`: 'make sqlc', `recipe`: ['cd backend && $(SQLC) generate'], `type`: 'make_target'}},
  {`id`: 'make:test', `props`: {`help`: 'All test suites', `label`: 'make test', `type`: 'make_target'}},
  {`id`: 'make:test-backend', `props`: {`help`: 'Go unit tests (no database)', `label`: 'make test-backend', `recipe`: ['cd backend && go test ./internal/...'], `type`: 'make_target'}},
  {`id`: 'make:test-integration', `props`: {`help`: 'Go integration + RLS + API tests against montra_test (sequential packages)', `label`: 'make test-integration', `recipe`: ['cd backend && go test -p 1 -count=1 ./tests/... ./internal/...'], `type`: 'make_target'}},
  {`id`: 'make:vuln', `props`: {`help`: 'Dependency vulnerability scan (requires govulncheck)', `label`: 'make vuln', `recipe`: ['cd backend && go run golang.org/x/vuln/cmd/govulncheck@v1.1.4 ./...'], `type`: 'make_target'}},
  {`id`: 'make:web', `props`: {`help`: 'Run the React portal on :5173 (proxies /api to :8080)', `label`: 'make web', `recipe`: ['cd web && pnpm dev'], `type`: 'make_target'}},
  {`id`: 'make:web-build', `props`: {`help`: 'Production build of the web portal (no deploy)', `label`: 'make web-build', `recipe`: ['cd web && pnpm build'], `type`: 'make_target'}},
  {`id`: 'make:web-lint', `props`: {`help`: 'Web typecheck + lint', `label`: 'make web-lint', `recipe`: ['cd web && pnpm typecheck && pnpm lint'], `type`: 'make_target'}},
  {`id`: 'make:web-test', `props`: {`help`: 'Web unit tests', `label`: 'make web-test', `recipe`: ['cd web && pnpm test'], `type`: 'make_target'}},
  {`id`: 'make:worker', `props`: {`help`: 'Run the Go worker (jobs, scheduler, outbox)', `label`: 'make worker', `recipe`: ['cd backend && go run ./cmd/worker'], `type`: 'make_target'}}
] AS row
MERGE (n:Entity {id: row.id})
SET n:MakeTarget, n += row.props;
