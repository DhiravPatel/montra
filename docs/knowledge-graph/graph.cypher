MERGE (n:Entity {id: row.id})
SET n:Config, n += row.props;
UNWIND [
  {`id`: 'adr:ADR-001', `props`: {`label`: 'ADR-001 Monorepo layout', `type`: 'decision'}},
  {`id`: 'adr:ADR-002', `props`: {`label`: 'ADR-002 Identity authority and session model', `type`: 'decision'}},
  {`id`: 'adr:ADR-003', `props`: {`label`: 'ADR-003 Database access, schema and RLS identity propagation', `type`: 'decision'}},
  {`id`: 'adr:ADR-004', `props`: {`label`: 'ADR-004 Forward-only SQL migrations and runner', `type`: 'decision'}},
