UNWIND [
  {`id`: 'step:feature-3.1/01', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Sign-up. The sign-up form posts `POST /auth/register` with email, password, display name, country, currency, time zone, locale, `accept_terms`, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.1/02', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Verification. The link opens `/verify-email` with a token, which the page posts to `POST /auth/email/verify`. Tokens are 256-bit, hashed, single use and …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.1/03', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Sign-in. `POST /auth/login` checks the throttle counters (per email hash and per IP), verifies the password and creates a `user_sessions` row. Web receives …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.1/04', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Staying signed in. `GET /auth/session` returns the account summary. `POST /auth/refresh` rotates the tokens (empty body for web cookies; `refresh_token` for …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.1/05', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Password reset. `POST /auth/password/forgot` always answers the same way and emails a 1-hour link (`auth.send_password_reset`). `POST /auth/password/reset` …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.1/06', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Security settings. `POST /me/password` changes the password and signs out other sessions. Two-step verification: `POST /me/mfa/totp/setup` (returns …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.1/07', `props`: {`flow`: 'flow:feature-3.1', `label`: 'Security-relevant events are written to `security_events` and the person is emailed about important ones (`auth.send_security_email`); an in-app copy goes …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.10/01', `props`: {`flow`: 'flow:feature-3.10', `label`: 'Each page is uploaded with purpose `receipt` ([2.10](#210-files-and-storage)).', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.10/02', `props`: {`flow`: 'flow:feature-3.10', `label`: '`POST /receipts` (with `Idempotency-Key`) takes the page `file_ids` in order and an optional note. By default the receipt is `needs_review` and nothing is …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.10/03', `props`: {`flow`: 'flow:feature-3.10', `label`: '`receipts.extract` runs the configured `Extractor` and stores a new `receipt_extractions` version with candidate values, confidences, `receipt_line_items`, …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.10/04', `props`: {`flow`: 'flow:feature-3.10', `label`: '`PATCH /receipts/{id}/review` saves the reviewed values (status `reviewed`). `POST /receipts/{id}/process` reads again (a new version).', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.10/05', `props`: {`flow`: 'flow:feature-3.10', `label`: '`GET /receipts/{id}/match-candidates` suggests existing transactions with `reason_codes` (`same_amount` or `amount_close`, `same_date` or `near_date`, …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.10/06', `props`: {`flow`: 'flow:feature-3.10', `label`: '`POST /receipts/{id}/unlink`, `POST /receipts/{id}/discard` and `POST /receipts/{id}/restore` (optional `?version=`) are audited.', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.10/07', `props`: {`flow`: 'flow:feature-3.10', `label`: '`GET /receipts` is the inbox, newest first, cursor-paged, filtered by status.', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.11/01', `props`: {`flow`: 'flow:feature-3.11', `label`: 'Upload the file with purpose `statement_import`, then `POST /imports` (with `Idempotency-Key`) naming the account. The batch is `uploaded`; `imports.parse` …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.11/02', `props`: {`flow`: 'flow:feature-3.11', `label`: 'The parser suggests a mapping with `mapping_note_codes` (`no_header_row`, `ambiguous_date_order`, `decimal_comma`, `check_sign_convention`, ...). When the …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.11/03', `props`: {`flow`: 'flow:feature-3.11', `label`: 'Normalization computes fingerprints and flags duplicates: `already_imported` (same fingerprint or external ID) and `possible_duplicate` with reason codes. …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.11/04', `props`: {`flow`: 'flow:feature-3.11', `label`: '`GET /imports/{id}/rows` lists rows by status; `PATCH /imports/{id}/rows/{rowId}` corrects a value (`posted_date`, `amount`, `category_id`, `description`) …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.11/05', `props`: {`flow`: 'flow:feature-3.11', `label`: '`POST /imports/{id}/confirm` (with `Idempotency-Key`) queues `imports.process`, which creates one transaction per row in its own database transaction with …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.11/06', `props`: {`flow`: 'flow:feature-3.11', `label`: 'Matching. `GET /reconciliation/candidates` returns suggestions of kind `statement_to_ledger`, `pending_to_posted` or `manual_to_imported`, one-to-one or …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.11/07', `props`: {`flow`: 'flow:feature-3.11', `label`: 'Balance check. `POST /accounts/{id}/reconciliations` compares the ledger with a statement balance (or amount owed for a card) on a date and records …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.12/01', `props`: {`flow`: 'flow:feature-3.12', `label`: 'Analytics are computed on read from the person\'s own records: | Endpoint | Returns | |---|---| | `GET /analytics/cash-flow` | Income, gross expense, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.12/02', `props`: {`flow`: 'flow:feature-3.12', `label`: 'Reports. `POST /reports` with `report_type` (`monthly_summary`, `yearly_summary`, `income`, `expense`, `cash_flow`, `category`, `merchant`, `account`, …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.12/03', `props`: {`flow`: 'flow:feature-3.12', `label`: '`GET /reports` and `GET /reports/{id}` show status; `GET /reports/{id}/download` returns a short-lived signed link while the report has not expired (7 days …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.12/04', `props`: {`flow`: 'flow:feature-3.12', `label`: 'Schedules. `POST /reports/schedules` (weekly or monthly), `GET /reports/schedules`, `GET /reports/schedules/{id}`, `PATCH /reports/schedules/{id}` (with …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.12/05', `props`: {`flow`: 'flow:feature-3.12', `label`: 'Other exports: group expenses (`GET /groups/{id}/export`, CSV), a goal\'s contributions (`GET /goals/{id}/export`, CSV) and the full data export …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.13/01', `props`: {`flow`: 'flow:feature-3.13', `label`: 'AI is off unless the owner sets `AI_PROVIDER=anthropic` and `ANTHROPIC_API_KEY`. The default is `disabled`.', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.13/02', `props`: {`flow`: 'flow:feature-3.13', `label`: 'Even then, a person must grant the `ai_processing` consent (`POST /me/consents`) and turn AI on with `PATCH /ai/preferences`; without the consent the answer …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.13/03', `props`: {`flow`: 'flow:feature-3.13', `label`: 'With the provider off, consent missing, AI turned off or the daily cap reached, `POST /ai/ask` and `POST /ai/report-summary` answer deterministically …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.13/04', `props`: {`flow`: 'flow:feature-3.13', `label`: 'When on, the model gets minimal, redacted context and only read-only tools that run as the caller under RLS. Untrusted text is fenced, outputs are …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.14/01', `props`: {`flow`: 'flow:feature-3.14', `label`: 'Daily, `insights.generate_all` queues `insights.generate` per person; `POST /ai/insights/generate` runs it on demand. Despite the `/ai` prefix, this …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.14/02', `props`: {`flow`: 'flow:feature-3.14', `label`: 'Each of the 11 rules (`backend/internal/insights/insights.go` and `more_rules.go`) produces candidates with evidence, a confidence and a fingerprint. Rules …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.14/03', `props`: {`flow`: 'flow:feature-3.14', `label`: 'Up to three new `notice` or `warning` insights per run create an `insight` notification ("Something unusual in your spending"), linking to `/insights/{id}`.', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.14/04', `props`: {`flow`: 'flow:feature-3.14', `label`: '`GET /insights` lists warnings first, then newest (cursor-paged; `all=true` includes dismissed, expected, resolved and muted). `GET /insights/{id}` reads …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.14/05', `props`: {`flow`: 'flow:feature-3.14', `label`: '`POST /insights/{id}/actions` with `dismiss`, `snooze`, `expected`, `resolved`, `mute` or `reopen`. `POST /insights/{id}/feedback` records one answer per …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.15/01', `props`: {`flow`: 'flow:feature-3.15', `label`: '`POST /goals` creates the goal and its milestones; the owner is listed in `members` with role `owner`.', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.15/02', `props`: {`flow`: 'flow:feature-3.15', `label`: '`POST /goals/{id}/contributions` (with `Idempotency-Key`) records a `contribution` or `withdrawal`, `planned` or `recorded`; linking a transaction marks it …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.15/03', `props`: {`flow`: 'flow:feature-3.15', `label`: 'Each change emits `goal.changed`; `goals.evaluate` marks reached milestones (25, 50, 75 and 100 % by default), moves the goal between active and achieved, …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.15/04', `props`: {`flow`: 'flow:feature-3.15', `label`: '`GET /goals/{id}/forecast` returns the required pace and projected completion with `assumption_codes` (`exact_amounts_no_growth`, `recent_pace_window`, …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.15/05', `props`: {`flow`: 'flow:feature-3.15', `label`: 'Sharing: `POST /goals/{id}/members`, `PATCH /goals/{id}/members/{userId}` (role `contributor` or `viewer`), `DELETE /goals/{id}/members/{userId}`. Each …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.15/06', `props`: {`flow`: 'flow:feature-3.15', `label`: 'Lifecycle: `POST /goals/{id}/pause`, `resume`, `achieve`, `cancel`, and `DELETE /goals/{id}` (archive, history kept). `PATCH /goals/{id}` changes only the …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.15/07', `props`: {`flow`: 'flow:feature-3.15', `label`: '`GET /goals/{id}/export` returns CSV. `goals.reminders` (every 6 hours) sends contribution reminders when enabled.', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.16/01', `props`: {`flow`: 'flow:feature-3.16', `label`: '`GET /users/search?q=` matches only an exact username (case-insensitive, a leading `@` ignored, 3 or more characters) of people with …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.16/02', `props`: {`flow`: 'flow:feature-3.16', `label`: '`POST /friend-requests` creates a request, honouring the addressee\'s `allow_friend_requests` (`everyone`, `friends_of_friends`, `nobody`). If the other …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.16/03', `props`: {`flow`: 'flow:feature-3.16', `label`: '`POST /friend-requests/{id}/accept`, `decline` or `cancel`; accepted requests become `user_connections`. `GET /friend-requests` and `GET /connections` list …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.16/04', `props`: {`flow`: 'flow:feature-3.16', `label`: '`POST /users/{userId}/block` and `DELETE /users/{userId}/block`; `POST /users/{userId}/mute` mutes or unmutes (no more notifications from that person). `GET …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.17/01', `props`: {`flow`: 'flow:feature-3.17', `label`: '`POST /groups` sets the type, currency, default split method, debt simplification, `require_join_approval`, `allow_member_invites`, and for trips the …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.17/02', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Invitations. `POST /groups/{id}/invitations` with `kind: link` returns a `token` and a `share_url` once (expiry 1 to 30 days, default 7; optional …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.17/03', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Joining by link. The link is `/groups/join#token=…`; the token stays in the URL fragment, never in a path, query or log. The page posts it to `POST …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.17/04', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Direct adds and requests. `POST /groups/{id}/members` adds a discoverable username or a friend\'s `user_id`. `POST /groups/{id}/join-requests` asks to join; …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.17/05', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Members. `PATCH /groups/{id}/members/{userId}` changes a role (admins) or one\'s own `notification_level` (`all`, `important`, `none`). `DELETE …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.17/06', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Settings and lifecycle. `PATCH /groups/{id}` with `version` (currency fixed once expenses exist). `POST /groups/{id}/archive` makes the group read-only and …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.17/07', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Activity. Every change writes `group_activity_events` with an enumerated `kind` and a summary of IDs and names (never amounts or sentences). `GET …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.17/08', `props`: {`flow`: 'flow:feature-3.17', `label`: 'Trips. `groups.trip_reminders` (hourly, local daytime) tells members when a trip starts and when it ended with open balances.', `order`: 8, `type`: 'step'}},
  {`id`: 'step:feature-3.18/01', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Expense. `POST /groups/{id}/expenses` (with `Idempotency-Key`) with amount, payers, `split_method` (`equal`, `exact`, `percentage`, `shares`, `itemized`), …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.18/02', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Foreign currency. Send `original_amount`, `original_currency` and either `fx_rate` (manual) or `fx_rate_source: lookup` (Montra\'s rate for the expense …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.18/03', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Personal records. With `payer_account_id`, or later with `POST /groups/{id}/expenses/{expenseId}/my-record`, a payer records the payment in their own …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.18/04', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Edit and history. `PATCH /groups/{id}/expenses/{expenseId}` sends the full expense with `version`; each edit is kept in `group_expense_revisions`. `DELETE` …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.18/05', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Balances. `GET /groups/{id}/balances` returns per member: paid, share, confirmed settlements, `net` (positive means owed), pending reported payments, …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.18/06', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Settlements. `POST /groups/{id}/settlements` (with `Idempotency-Key`; `state: paid` by default, or `proposed`). Actions with `version`: `mark-paid` (payer), …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.18/07', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Recurring shared bills. `POST /groups/{id}/recurring-expenses` (with `Idempotency-Key`) stores a schedule, amount, split template and `auto_add`. …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.18/08', `props`: {`flow`: 'flow:feature-3.18', `label`: 'Reports. `GET /groups/{id}/reports` (totals by category, member and month, plus a trip summary); `GET /groups/{id}/export` returns CSV.', `order`: 8, `type`: 'step'}},
  {`id`: 'step:feature-3.19/01', `props`: {`flow`: 'flow:feature-3.19', `label`: '`POST /communities` (name, URL name `slug`, description, rules, topics, visibility). `GET /communities` lists them; `GET /communities/{ref}` accepts an ID …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.19/02', `props`: {`flow`: 'flow:feature-3.19', `label`: 'Membership. `POST /communities/{id}/join` joins a public community or asks to join a private one (the worker notifies moderators with …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.19/03', `props`: {`flow`: 'flow:feature-3.19', `label`: 'Invitations. `POST /communities/{id}/invitations` (link or username; the token and `share_url` are shown once). `POST /community-invitations/preview` and …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.19/04', `props`: {`flow`: 'flow:feature-3.19', `label`: 'Posts. `POST /communities/{id}/posts` (kind `discussion`, `question`, `resource` with `link_url`, `poll` with options). The feed `GET …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.19/05', `props`: {`flow`: 'flow:feature-3.19', `label`: 'Comments and reactions. `POST /posts/{id}/comments` (with an optional parent for replies), `PATCH /comments/{id}`, `DELETE /comments/{id}`; `POST …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.19/06', `props`: {`flow`: 'flow:feature-3.19', `label`: 'Comments notify the post author and, for replies, the author of the parent comment (`communities.notify_comment`); `@username` mentions notify up to 10 …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.2/01', `props`: {`flow`: 'flow:feature-3.2', `label`: 'After signing in, a user whose `onboarding_completed` is false is sent to `/onboarding`. The page reads `GET /me/onboarding` (`completed_steps`, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.2/02', `props`: {`flow`: 'flow:feature-3.2', `label`: 'Each step saves its own data with the normal endpoints: `PATCH /me/preferences` (country, currency, time zone, week and month start, `income_range`, …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.2/03', `props`: {`flow`: 'flow:feature-3.2', `label`: 'After each step the client records progress with `POST /me/onboarding`. The server merges steps with what it stored (a completed step wins over a skipped …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.2/04', `props`: {`flow`: 'flow:feature-3.2', `label`: 'The user lands on the dashboard, or on the link they were opening when they signed up.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.20/01', `props`: {`flow`: 'flow:feature-3.20', `label`: '`POST /challenges` with type, metric (`days`, `streak`, `milestones`, `percent`), target, dates, rules and visibility (`private`, `group`, `community`). The …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.20/02', `props`: {`flow`: 'flow:feature-3.20', `label`: '`POST /challenges/{id}/join` with `share_progress` and `show_on_leaderboard`; `PATCH /challenges/{id}/participation` changes them; `POST …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.20/03', `props`: {`flow`: 'flow:feature-3.20', `label`: '`POST /challenges/{id}/progress` checks in for a day; re-sending a date corrects it. Streaks are computed by the challenges domain logic.', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.20/04', `props`: {`flow`: 'flow:feature-3.20', `label`: '`challenges.notify_milestone` sends one notice at halfway; `challenges.notify_completed` on completion.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.20/05', `props`: {`flow`: 'flow:feature-3.20', `label`: '`GET /challenges/{id}/leaderboard` shows opted-in participants as percentages only. `PATCH /challenges/{id}` (creator, with `version`) and `POST …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.21/01', `props`: {`flow`: 'flow:feature-3.21', `label`: '`POST /posts/{id}/reports` or `POST /content-reports` (target type and reason: `spam`, `abuse`, `harassment`, `scam`, `impersonation`, `misinformation`, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.21/02', `props`: {`flow`: 'flow:feature-3.21', `label`: '`moderation.reported` notifies the community\'s moderators. Once three different people report the same published content, it is hidden pending review.', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.21/03', `props`: {`flow`: 'flow:feature-3.21', `label`: 'Community moderators use `GET /communities/{id}/moderation/reports`, `GET /communities/{id}/moderation/actions` and `POST …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.21/04', `props`: {`flow`: 'flow:feature-3.21', `label`: 'Staff use `GET /moderation/reports`, `GET /moderation/actions`, `POST /moderation/actions` (account sanctions, community suspensions, dismissing group …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.21/05', `props`: {`flow`: 'flow:feature-3.21', `label`: '`POST /moderation/actions/{id}/reverse` reverses an action. `moderation.actioned` notifies the affected person.', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.21/06', `props`: {`flow`: 'flow:feature-3.21', `label`: 'The affected person reads `GET /me/moderation` and `GET /me/moderation/appeals`, and appeals with `POST /moderation/actions/{id}/appeals`. Another moderator …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.22/01', `props`: {`flow`: 'flow:feature-3.22', `label`: 'A feature (usually a worker job) calls `notifications.Create`, which inserts the in-app row (deduplicated by key) and one delivery plus one …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.22/02', `props`: {`flow`: 'flow:feature-3.22', `label`: '`notifications.deliver` honours preferences and quiet hours (`quiet_hours_start` and `quiet_hours_end` in the person\'s time zone): inside quiet hours the …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.22/03', `props`: {`flow`: 'flow:feature-3.22', `label`: 'Digests. `PATCH /me/preferences {"email_digest": "daily" | "weekly" | "off"}` sets the account cadence; a category\'s `digest` overrides it. The hourly …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.22/04', `props`: {`flow`: 'flow:feature-3.22', `label`: 'Centre. `GET /notifications`, `GET /notifications/unread-count`, `PATCH /notifications/{notificationId}` (read, unread, archive), `POST …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.22/05', `props`: {`flow`: 'flow:feature-3.22', `label`: 'Preferences. `GET /notifications/preferences` and `PATCH /notifications/preferences` (items with category, channel, optional `group_id`, `enabled`, …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.22/06', `props`: {`flow`: 'flow:feature-3.22', `label`: 'Browser push. `GET /notifications/push-config` says whether the server can send and gives the public VAPID key. The browser subscribes and registers with …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.22/07', `props`: {`flow`: 'flow:feature-3.22', `label`: 'Unsubscribe. Optional emails link to `<web>/unsubscribe#token=…`; the page posts the token to `POST /notifications/unsubscribe` without sign-in and gets the …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.23/01', `props`: {`flow`: 'flow:feature-3.23', `label`: '`GET /integrations` returns the registry with an honest `status` (`available`, `not_configured`, `unavailable`) and reason, plus the person\'s connections. …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.23/02', `props`: {`flow`: 'flow:feature-3.23', `label`: 'When an adapter is registered (only with real credentials; tests use a sandbox adapter), connecting works like this: `POST /integrations/{ref}/connect` with …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.23/03', `props`: {`flow`: 'flow:feature-3.23', `label`: '`POST /integrations/{ref}/sync` queues `integrations.sync` (202; 409 `sync_running` while one runs). Syncs fetch cursor pages, map items to transactions by …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.23/04', `props`: {`flow`: 'flow:feature-3.23', `label`: '`integrations.schedule` (every 30 minutes) starts scheduled syncs every 6 hours, expires consents (and notifies), and fails runs abandoned for more than 2 …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.23/05', `props`: {`flow`: 'flow:feature-3.23', `label`: '`POST /webhooks/{provider}` accepts signed provider events (at most 256 KiB): valid ones are stored and queued (`integrations.webhook`), duplicates …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.23/06', `props`: {`flow`: 'flow:feature-3.23', `label`: '`DELETE /integrations/{ref}?confirm=true[&delete_data=true]` revokes at the provider, deletes tokens and can void imported transactions.', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.24/01', `props`: {`flow`: 'flow:feature-3.24', `label`: 'Every amount carries its currency ([2.9](#29-money-currencies-and-exchange-rates)). A transaction may also carry `original_amount`, `original_currency` and …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.24/02', `props`: {`flow`: 'flow:feature-3.24', `label`: 'Rates live in `fx_rates`: provider rates (append-only) and the person\'s manual overrides. With `FX_PROVIDER=ecb`, `fx.refresh` fetches ECB reference rates …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.24/03', `props`: {`flow`: 'flow:feature-3.24', `label`: '`GET /fx/rates` lists rates; `POST /fx/rates` adds a manual rate with `as_of` (an instant, or a date meaning the start of that day in the person\'s time …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.24/04', `props`: {`flow`: 'flow:feature-3.24', `label`: '`GET /fx/convert?amount&from&to&policy&date` converts exactly and discloses the rate, its source and time. `historical` uses the latest rate on or before …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.24/05', `props`: {`flow`: 'flow:feature-3.24', `label`: 'Analytics and the dashboard keep currencies separate and, when a display currency is chosen, add a converted total with the policy (`latest_on_or_before`) …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.25/01', `props`: {`flow`: 'flow:feature-3.25', `label`: '`GET /search?q&scope&limit&sort&save`. `q` is 2 to 100 characters; `scope` is `all` or one section; `limit` is per section (1 to 20).', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.25/02', `props`: {`flow`: 'flow:feature-3.25', `label`: 'Each section queries only records the caller may see: planning sections are the caller\'s own; groups and posts follow membership; users follow the …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.25/03', `props`: {`flow`: 'flow:feature-3.25', `label`: 'With `save=true` (sent when the person submits, never while typing) the query goes to `search_history`. `GET /search/recent` returns the last 20; `DELETE …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.26/01', `props`: {`flow`: 'flow:feature-3.26', `label`: '`GET /me` returns the account summary and profile; `PATCH /me` changes only the fields sent (`display_name`, `username`, `bio`, `coarse_location`, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.26/02', `props`: {`flow`: 'flow:feature-3.26', `label`: 'Photo. Upload with purpose `avatar`, then `PATCH /me {"avatar_file_id": …}`; `""` removes it (the file is kept). Clients display it through a short-lived …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.26/03', `props`: {`flow`: 'flow:feature-3.26', `label`: '`GET /me/preferences` and `PATCH /me/preferences` read and change preferences. Clients apply them at once: theme, language, number and date formats, week …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.26/04', `props`: {`flow`: 'flow:feature-3.26', `label`: 'Profile visibility is enforced in the database: `private` shows the profile only to the person, people in an active group with them and people in a pending …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.27/01', `props`: {`flow`: 'flow:feature-3.27', `label`: '`POST /support/requests` with kind, subject and body returns an 8-character `reference`. `GET /support/requests` and `GET /support/requests/{id}` list and …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.27/02', `props`: {`flow`: 'flow:feature-3.27', `label`: '`GET /support/requests/{id}/messages` and `POST /support/requests/{id}/messages` form a thread between the requester and staff.', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.27/03', `props`: {`flow`: 'flow:feature-3.27', `label`: 'A staff reply queues `support.notify_reply`, which notifies the requester (`account/support_reply`, link `/help/requests/{id}`) without the message text. …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.27/04', `props`: {`flow`: 'flow:feature-3.27', `label`: 'Signed-out people use `POST /support/contact` with a `contact_email` (202 with a reference).', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.27/05', `props`: {`flow`: 'flow:feature-3.27', `label`: 'Staff with the `support` role see `GET /support/queue` (security and privacy first) and change status with `PATCH /support/queue/{id}` (audited). …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.27/06', `props`: {`flow`: 'flow:feature-3.27', `label`: '`GET /legal` (public) returns the current terms and privacy versions and every consent type\'s version.', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.28/01', `props`: {`flow`: 'flow:feature-3.28', `label`: 'Consents. `GET /me/consents`, `POST /me/consents` (type and the current version from `GET /legal`), `DELETE /me/consents/{consentType}`. Types: `terms` and …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.28/02', `props`: {`flow`: 'flow:feature-3.28', `label`: 'Export. `POST /me/export` (recent re-authentication, `export` rate limit) queues `privacy.export`, which builds a ZIP of JSON sections for every personal …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.28/03', `props`: {`flow`: 'flow:feature-3.28', `label`: 'Deletion. `GET /me/deletion-request` explains the consequences, what is retained and the effect on each group (with codes). `POST /me/deletion-request` …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.28/04', `props`: {`flow`: 'flow:feature-3.28', `label`: 'Deactivation. `POST /me/deactivate` (re-authentication) sets the account to `deactivated`, revokes every session and records a security event. Signing in …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.29/01', `props`: {`flow`: 'flow:feature-3.29', `label`: '`GET /limits` returns the values from configuration and the caller\'s storage use. `note_code` (`fair_use_same_for_everyone`) localizes the explanation.', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.29/02', `props`: {`flow`: 'flow:feature-3.29', `label`: 'Enforcement lives where the action happens: storage in `POST /files/upload-intent` (`storage_quota_exceeded` with used and quota bytes), open-record caps in …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.3/01', `props`: {`flow`: 'flow:feature-3.3', `label`: 'Home reads `GET /dashboard/widgets` for the saved layout (widget key, position, visibility, settings). New widgets added by the server appear at the end, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.3/02', `props`: {`flow`: 'flow:feature-3.3', `label`: 'Period widgets come from one call, `GET /dashboard/summary`, with `range` or `from`/`to` and optional filters (`account_id`, `category_id`, `merchant_id`, …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.3/03', `props`: {`flow`: 'flow:feature-3.3', `label`: 'Planning widgets come from one call, `GET /dashboard/planning`, which is independent of the period filter: up to 5 active budgets (fullest first), up to 8 …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.3/04', `props`: {`flow`: 'flow:feature-3.3', `label`: 'Hidden planning widgets are not requested. Saving the layout calls `PATCH /dashboard/widgets` with the full list, or `{"reset": true}`.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.3/05', `props`: {`flow`: 'flow:feature-3.3', `label`: 'Cards link to their full screens; widgets that drill down open the transactions list with the same filters.', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.30/01', `props`: {`flow`: 'flow:feature-3.30', `label`: 'The platform role lives on `users.platform_role` (`user`, `support`, `admin`) and is set by the owner in the database; there is no API to change it.', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.30/02', `props`: {`flow`: 'flow:feature-3.30', `label`: '`GET /admin/usage?days=30` (admins only) calls the `admin_usage` database function: active, new and pending-deletion users, stored bytes by area, …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.30/03', `props`: {`flow`: 'flow:feature-3.30', `label`: 'The support queue and staff moderation are described in [3.27](#327-help-and-support) and [3.21](#321-moderation-and-appeals).', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.30/04', `props`: {`flow`: 'flow:feature-3.30', `label`: 'The web navigation shows a Staff section only to staff roles.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.4/01', `props`: {`flow`: 'flow:feature-3.4', `label`: '`POST /accounts` (with `Idempotency-Key`) creates `financial_accounts` and, when there is an opening balance, an `opening_balance` ledger event. Credit …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.4/02', `props`: {`flow`: 'flow:feature-3.4', `label`: 'A balance is always the opening balance plus the sum of `account_ledger_entries`. `GET /accounts` lists own and household-shared accounts with balances; …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.4/03', `props`: {`flow`: 'flow:feature-3.4', `label`: '`PATCH /accounts/{id}` edits name, label, icon, colour, last digits, `include_in_overview`, credit limit, statement and due days, order, and sharing …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.4/04', `props`: {`flow`: 'flow:feature-3.4', `label`: '`POST /accounts/{id}/adjustments` (with `Idempotency-Key` and a reason) records an `adjustment` transaction so the balance matches reality, with an audit trail.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.4/05', `props`: {`flow`: 'flow:feature-3.4', `label`: 'Lifecycle: `POST /accounts/{id}/archive`, `POST /accounts/{id}/close` (balance must be zero), `POST /accounts/{id}/restore`.', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.4/06', `props`: {`flow`: 'flow:feature-3.4', `label`: 'Payment methods: `GET /payment-methods`, `POST /payment-methods`, `PATCH /payment-methods/{id}` (with `version`), `DELETE /payment-methods/{id}` (deletes an …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.5/01', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Create. The form posts `POST /transactions` with an `Idempotency-Key`. The service checks that the account is active and the caller\'s own, validates the …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.5/02', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Transfer. `POST /transactions/transfers` (with `Idempotency-Key`) writes a `transfers` row and two linked legs, plus an optional fee transaction. A …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.5/03', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Refunds and reimbursements. `POST /transactions/{id}/refunds` (with `Idempotency-Key`, `type: refund | reimbursement`) creates a transaction linked to the …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.5/04', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Edit. `PATCH /transactions/{id}` with `version`. When the amount, date, account or balance effect changes, the ledger gets a reversing entry for the old …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.5/05', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Void and restore. `DELETE /transactions/{id}` sets `status = voided` with reversing ledger entries; `POST /transactions/{id}/restore` undoes it. `POST …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.5/06', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Bulk and duplicate. `POST /transactions/bulk-update` changes category, tags or account for many; `POST /transactions/{id}/duplicate` copies one of the …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.5/07', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Attachments. Upload a file with purpose `transaction_attachment` ([2.10](#210-files-and-storage)), then `POST /transactions/{id}/attachments`; list with …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.5/08', `props`: {`flow`: 'flow:feature-3.5', `label`: 'History. `GET /transactions/{id}/audit` shows who changed what and when (actor `user`, `system`, `import`, `recurring`, `integration`).', `order`: 8, `type`: 'step'}},
  {`id`: 'step:feature-3.5/09', `props`: {`flow`: 'flow:feature-3.5', `label`: 'Search. `GET /transactions` and `GET /transactions/search` take the same filters: range or dates, type, account, category, merchant, payment method, tag, …', `order`: 9, `type`: 'step'}},
  {`id`: 'step:feature-3.5/10', `props`: {`flow`: 'flow:feature-3.5', `label`: 'After commit, the outbox routes `transaction.*`, `transfer.created` and `transactions.bulk_updated` events to `budgets.evaluate`.', `order`: 10, `type`: 'step'}},
  {`id`: 'step:feature-3.6/01', `props`: {`flow`: 'flow:feature-3.6', `label`: 'Categories. Every new user starts with starter categories (with `system_key` for localization). `GET /categories`, `POST /categories`, `GET …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.6/02', `props`: {`flow`: 'flow:feature-3.6', `label`: 'Merging. `POST /categories/merge` (with a preview mode) and `POST /merchants/merge/preview` then `POST /merchants/merge` move every reference: transactions, …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.6/03', `props`: {`flow`: 'flow:feature-3.6', `label`: 'Merchants. `GET /merchants` (active unless `status` says otherwise, cursor-paged), `GET /merchants/{id}` with spending history, `PATCH /merchants/{id}`, …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.6/04', `props`: {`flow`: 'flow:feature-3.6', `label`: 'Tags. `GET /tags`, `POST /tags`, `GET /tags/{id}` (with usage), `PATCH /tags/{id}` (rename, recolor, archive), `DELETE /tags/{id}`.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.6/05', `props`: {`flow`: 'flow:feature-3.6', `label`: 'Rules. `GET /category-rules`, `POST /category-rules`, `GET /category-rules/{id}`, `PUT /category-rules/{id}`, `DELETE /category-rules/{id}`. A rule matches …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.7/01', `props`: {`flow`: 'flow:feature-3.7', `label`: '`POST /budgets` with type, period, limit, currency, allocations, filters (included accounts, excluded categories, merchants), rollover policy and cap, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.7/02', `props`: {`flow`: 'flow:feature-3.7', `label`: '`GET /budgets` and `GET /budgets/{id}` return progress: spent, limit, remaining, `pace` (`under_pace`, `on_track`, `ahead_of_pace`, `over_budget`) and …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.7/03', `props`: {`flow`: 'flow:feature-3.7', `label`: 'Any transaction change emits an outbox event that queues a debounced `budgets.evaluate` for the owner (or the group). The job recomputes progress, writes …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.7/04', `props`: {`flow`: 'flow:feature-3.7', `label`: 'For each new alert the job creates a `budget` notification (high priority at 100 % or more) unless the person snoozed that budget\'s alerts. `GET …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.7/05', `props`: {`flow`: 'flow:feature-3.7', `label`: 'Sharing: `POST /budgets/{id}/members`, `PATCH /budgets/{id}/members/{userId}` (role `editor` or `viewer`), `DELETE /budgets/{id}/members/{userId}`. Members …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.7/06', `props`: {`flow`: 'flow:feature-3.7', `label`: 'Group budgets (`group_id`) count all of the group\'s expenses and can be split between current members.', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.7/07', `props`: {`flow`: 'flow:feature-3.7', `label`: 'Lifecycle: `POST /budgets/{id}/pause`, `POST /budgets/{id}/resume`, `DELETE /budgets/{id}` (archive), `POST /budgets/{id}/restore`. `PATCH /budgets/{id}` …', `order`: 7, `type`: 'step'}},
  {`id`: 'step:feature-3.8/01', `props`: {`flow`: 'flow:feature-3.8', `label`: 'Rules. `POST /recurring-rules` (with `Idempotency-Key`) stores the schedule (`frequency`, `interval_count`/`interval_unit`, `by_month_day`, `by_weekday`, …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.8/02', `props`: {`flow`: 'flow:feature-3.8', `label`: 'Generation. Every 15 minutes `recurring.generate` materializes occurrences up to now and ahead (`recurring_occurrences`, unique per rule and date), …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.8/03', `props`: {`flow`: 'flow:feature-3.8', `label`: 'Occurrences. `POST /recurring-occurrences/{id}/actions` (with `Idempotency-Key`): `skip`, `reopen`, `postpone`, `set_amount`, `confirm` (record the …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.8/04', `props`: {`flow`: 'flow:feature-3.8', `label`: 'Rule actions. `PATCH /recurring-rules/{id}` edits this and future occurrences: if the dates do not change, postponed and own-amount occurrences are kept; if …', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.8/05', `props`: {`flow`: 'flow:feature-3.8', `label`: 'Bills. `POST /bills` (with `Idempotency-Key`) creates a bill with its own schedule, provider, amount, payment account and optional document. The bill\'s …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.8/06', `props`: {`flow`: 'flow:feature-3.8', `label`: 'Calendar. `GET /calendar?from&to` merges recurring occurrences, bills, shared group recurring expenses, subscription renewals, trial ends and goal target …', `order`: 6, `type`: 'step'}},
  {`id`: 'step:feature-3.9/01', `props`: {`flow`: 'flow:feature-3.9', `label`: '`POST /subscriptions` stores a manual subscription (status `trial` when a trial end is given, otherwise `active`) and a `created` event. Duplicate warnings …', `order`: 1, `type`: 'step'}},
  {`id`: 'step:feature-3.9/02', `props`: {`flow`: 'flow:feature-3.9', `label`: 'Detection. Daily, `subscriptions.detect_all` queues `subscriptions.detect` per person; `POST /subscriptions/detections/refresh` queues it on demand. The …', `order`: 2, `type`: 'step'}},
  {`id`: 'step:feature-3.9/03', `props`: {`flow`: 'flow:feature-3.9', `label`: 'Payments. `GET /subscriptions/{id}/payment-candidates` suggests recorded charges; `POST /subscriptions/{id}/payments` (with `Idempotency-Key`) links one, …', `order`: 3, `type`: 'step'}},
  {`id`: 'step:feature-3.9/04', `props`: {`flow`: 'flow:feature-3.9', `label`: 'Renewals. The hourly `subscriptions.renewals` job sends reminders `reminder_days_before` a renewal and before a trial ends, and moves the renewal date forward.', `order`: 4, `type`: 'step'}},
  {`id`: 'step:feature-3.9/05', `props`: {`flow`: 'flow:feature-3.9', `label`: 'Cancelling. `POST /subscriptions/{id}/cancellation-started` moves to `cancellation_pending` with a checklist (`PATCH …', `order`: 5, `type`: 'step'}},
  {`id`: 'step:feature-3.9/06', `props`: {`flow`: 'flow:feature-3.9', `label`: '`GET /subscriptions/summary` returns normalized monthly and annual totals per currency, upcoming renewals and trials ending. `PATCH /subscriptions/{id}` …', `order`: 6, `type`: 'step'}},
