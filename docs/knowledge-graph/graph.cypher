// Montra knowledge graph: Neo4j import generated by scripts/docs/gen_knowledge_graph.py.
// Idempotent (MERGE). Run with: cypher-shell -f docs/knowledge-graph/graph.cypher
// Every node also carries the :Entity label so edges can MATCH on one indexed id.
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
UNWIND [
  {`id`: 'app:backend', `props`: {`label`: 'Go API + worker (backend/)', `type`: 'app'}},
  {`id`: 'app:contract', `props`: {`label`: 'OpenAPI contract (contracts/openapi)', `type`: 'app'}},
  {`id`: 'app:database', `props`: {`label`: 'Postgres schema and RLS (supabase/migrations)', `type`: 'app'}},
  {`id`: 'app:docs', `props`: {`label`: 'Documentation (docs/)', `type`: 'app'}},
  {`id`: 'app:mobile', `props`: {`label`: 'Flutter app (mobile/)', `type`: 'app'}},
  {`id`: 'app:repo', `props`: {`label`: 'Repository tooling: Makefile, scripts, CI, READMEs, env templates', `type`: 'app'}},
  {`id`: 'app:web', `props`: {`label`: 'React web portal (web/)', `type`: 'app'}}
] AS row
MERGE (n:Entity {id: row.id})
SET n:App, n += row.props;
