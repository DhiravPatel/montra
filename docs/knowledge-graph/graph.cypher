  {`id`: 'config:DATA_ENCRYPTION_KEYS', `props`: {`field`: 'Security.DataEncryptionKeys', `label`: 'DATA_ENCRYPTION_KEYS', `loader`: 'keyring', `required`: true, `secret`: true, `type`: 'config', `validation`: ['DATA_ENCRYPTION_KEYS is required (format kid:base64-32-byte-key)']}},
