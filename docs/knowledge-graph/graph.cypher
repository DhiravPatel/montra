  {`id`: 'config:AUTH_REQUIRE_EMAIL_VERIFIED', `props`: {`field`: 'Auth.RequireEmailVerified', `label`: 'AUTH_REQUIRE_EMAIL_VERIFIED', `loader`: 'boolean', `type`: 'config', `validation`: ['EMAIL_PROVIDER=disabled cannot be combined with AUTH_REQUIRE_EMAIL_VERIFIED=true (users could never verify)', 'AUTH_REQUIRE_EMAIL_VERIFIED must be true outside development and test']}},
  {`id`: 'config:CORS_ALLOWED_ORIGINS', `props`: {`field`: 'HTTP.CORSAllowedOrigins', `label`: 'CORS_ALLOWED_ORIGINS', `loader`: 'list', `type`: 'config', `validation`: ['CORS_ALLOWED_ORIGINS must not contain * outside development']}},
  {`id`: 'config:DATABASE_MAX_CONNS', `props`: {`field`: 'Database.MaxConns', `label`: 'DATABASE_MAX_CONNS', `loader`: 'integer', `type`: 'config', `validation`: ['DATABASE_MAX_CONNS must be at least 1']}},
