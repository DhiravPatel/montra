    <node id="req:JOB-001"><data key="label">JOB-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:jobs", "section": "26. Backend, database, jobs (§8, §9, §11, §20B.22)", "spec_section": "§11", "status": "IN_PROGRESS", "text": "All job types (§11 list)"}</data></node>
    <node id="req:JOB-002"><data key="label">JOB-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/jobs", "section": "26. Backend, database, jobs (§8, §9, §11, §20B.22)", "spec_section": "§11", "status": "TESTED", "text": "Durable persistence, at-least-once, idempotent handlers"}</data></node>
    <node id="req:JOB-003"><data key="label">JOB-003</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/jobs", "section": "26. Backend, database, jobs (§8, §9, §11, §20B.22)", "spec_section": "§11", "status": "TESTED", "text": "Backoff+jitter, max attempts, dead-letter, manual retry"}</data></node>
