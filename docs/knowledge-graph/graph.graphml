    <node id="req:DATA-001"><data key="label">DATA-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "DB", "section": "23. Data model (§5)", "spec_section": "§5", "status": "TESTED", "text": "UUID PKs, timestamptz, IANA tz, ISO currency, exact money, FKs, checks, uniques, indexes"}</data></node>
