    <node id="req:WF-002"><data key="label">WF-002</data><data key="ntype">requirement</data><data key="nprops">{"deps": "TXN-015", "location": "BE", "section": "29. Critical workflows (§18) and documentation (§22, §23)", "spec_section": "§18", "status": "TESTED", "text": "Transfer workflow"}</data></node>
    <node id="req:WF-003"><data key="label">WF-003</data><data key="ntype">requirement</data><data key="nprops">{"deps": "SPLT", "location": "BE", "section": "29. Critical workflows (§18) and documentation (§22, §23)", "spec_section": "§18", "status": "VERIFIED", "text": "Group expense workflow"}</data></node>
