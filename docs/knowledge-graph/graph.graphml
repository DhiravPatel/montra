    <node id="req:RPT-002"><data key="label">RPT-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:reports", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§4.11", "status": "TESTED", "text": "Report filters incl. include/exclude transfers/refunds/pending, member where authorized"}</data></node>
    <node id="req:RPT-003"><data key="label">RPT-003</data><data key="ntype">requirement</data><data key="nprops">{"deps": "JOB", "location": "BE:reports", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§20B.12", "status": "VERIFIED", "text": "Reproducible snapshots; durable async jobs with queued/running/completed/failed/expired"}</data></node>
