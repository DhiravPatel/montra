    <node id="req:A11Y-001"><data key="label">A11Y-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "W, M", "section": "28. Testing, deployment, accessibility, localization (§14–§16)", "spec_section": "§16", "status": "TESTED", "text": "Keyboard/focus, SR labels, charts, contrast/non-color, scalable text, reduced motion, field errors, dialogs, touch targets, date/currency, AT review"}</data></node>
    <node id="req:ACCT-001"><data key="label">ACCT-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "DB, BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "TESTED", "text": "Types: cash, bank/current, savings, credit card, debit card, prepaid, digital wallet, UPI ref, loan, investment, shared household ledger, custom"}</data></node>
    <node id="req:ACCT-002"><data key="label">ACCT-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts, W, M", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "TESTED", "text": "Create, edit, archive, restore, close"}</data></node>
    <node id="req:ACCT-003"><data key="label">ACCT-003</data><data key="ntype">requirement</data><data key="nprops">{"deps": "DM:ledger", "location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3 §20B.4", "status": "TESTED", "text": "Opening balance + effective date as ledger event"}</data></node>
    <node id="req:ACCT-004"><data key="label">ACCT-004</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "TESTED", "text": "Manual balance correction as auditable adjustment with reason"}</data></node>
    <node id="req:ACCT-005"><data key="label">ACCT-005</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "IMPLEMENTED", "text": "Currency, institution label, icon/color, notes, display order"}</data></node>
    <node id="req:ACCT-006"><data key="label">ACCT-006</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "IMPLEMENTED", "text": "Include/exclude from overview"}</data></node>
    <node id="req:ACCT-007"><data key="label">ACCT-007</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "IMPLEMENTED", "text": "Account transaction history and balance history"}</data></node>
    <node id="req:ACCT-008"><data key="label">ACCT-008</data><data key="ntype">requirement</data><data key="nprops">{"deps": "IMP", "location": "BE:reconciliation", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3 §6", "status": "TESTED", "text": "Per-account statement import + reconcile endpoint"}</data></node>
    <node id="req:ACCT-009"><data key="label">ACCT-009</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "TESTED", "text": "Balance source label: manual/calculated/imported/provider-synchronized"}</data></node>
    <node id="req:ACCT-010"><data key="label">ACCT-010</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3 §20B.4", "status": "TESTED", "text": "Negative balances; credit liability, limit, available credit, statement balance"}</data></node>
    <node id="req:ACCT-011"><data key="label">ACCT-011</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:paymentmethods", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "TESTED", "text": "Payment methods (cash, UPI, debit, credit, transfer, wallet, cheque, other) with masked metadata only"}</data></node>
    <node id="req:ACCT-012"><data key="label">ACCT-012</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE validation", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3 §8", "status": "TESTED", "text": "Never store CVV/PIN/OTP/bank password/full credentials"}</data></node>
    <node id="req:ACCT-013"><data key="label">ACCT-013</data><data key="ntype">requirement</data><data key="nprops">{"deps": "ADR-007", "location": "DM:ledger", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§4.3", "status": "VERIFIED", "text": "Single authoritative ledger balance model"}</data></node>
    <node id="req:ACCT-014"><data key="label">ACCT-014</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:accounts", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§20B.4", "status": "TESTED", "text": "Block currency change once transactions exist"}</data></node>
    <node id="req:ACCT-015"><data key="label">ACCT-015</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:transactions", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§20B.4", "status": "TESTED", "text": "Archived account blocks new txns but keeps reporting"}</data></node>
    <node id="req:ACCT-016"><data key="label">ACCT-016</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE, RLS", "section": "5. Accounts &amp; payment methods (§4.3, §20B.4)", "spec_section": "§20B.4", "status": "VERIFIED", "text": "Ownership checks; group members cannot view personal accounts"}</data></node>
    <node id="req:AI-001"><data key="label">AI-001</data><data key="ntype">requirement</data><data key="nprops">{"deps": "ANL", "location": "BE:ai, W:ai-assistant, M:ai", "location_unresolved": ["M:ai", "W:ai-assistant"], "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "IN_PROGRESS", "text": "Natural-language questions over authorized data"}</data></node>
    <node id="req:AI-002"><data key="label">AI-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "IN_PROGRESS", "text": "Monthly summaries; explain changes, budgets, goals, group balances; plain-language reports"}</data></node>
    <node id="req:AI-003"><data key="label">AI-003</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "TESTED", "text": "Category suggestions, merchant normalization, duplicate suggestions, recurring detection"}</data></node>
    <node id="req:AI-004"><data key="label">AI-004</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai, BE:insights", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "TESTED", "text": "Forecasts with uncertainty; savings opportunities"}</data></node>
    <node id="req:AI-005"><data key="label">AI-005</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12 §20B.13", "status": "TESTED", "text": "Explain calculation/source period; label facts vs estimates vs suggestions"}</data></node>
    <node id="req:AI-006"><data key="label">AI-006</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "VERIFIED", "text": "Current-user scope; deterministic first; minimal redacted context"}</data></node>
    <node id="req:AI-007"><data key="label">AI-007</data><data key="ntype">requirement</data><data key="nprops">{"deps": "AUTH-019", "location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12 §20B.13", "status": "TESTED", "text": "Disclosure, consent, disable, history retention/deletion"}</data></node>
    <node id="req:AI-008"><data key="label">AI-008</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:receipts, BE:imports", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "VERIFIED", "text": "No receipts/identifiers sent externally without consent + necessity"}</data></node>
    <node id="req:AI-009"><data key="label">AI-009</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "TESTED", "text": "Schema-validated output; never SQL/authz/commands"}</data></node>
    <node id="req:AI-010"><data key="label">AI-010</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "TESTED", "text": "No actions without confirmation; no investment/tax/credit/legal advice; no guarantees; no shame; no sensitive inference"}</data></node>
    <node id="req:AI-011"><data key="label">AI-011</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12 §20B.13", "status": "VERIFIED", "text": "Provider outage fallback; provider-off mode; manual workflows kept"}</data></node>
    <node id="req:AI-012"><data key="label">AI-012</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "TESTED", "text": "Track provider/model/latency/cost/safety without sensitive payloads"}</data></node>
    <node id="req:AI-013"><data key="label">AI-013</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "IMPLEMENTED", "text": "Never silently switch provider"}</data></node>
    <node id="req:AI-014"><data key="label">AI-014</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "VERIFIED", "text": "Free; fair-use controls only"}</data></node>
    <node id="req:AI-015"><data key="label">AI-015</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§20B.13", "status": "TESTED", "text": "Prompt-injection defenses for descriptions, receipts, imports, community"}</data></node>
    <node id="req:AI-016"><data key="label">AI-016</data><data key="ntype">requirement</data><data key="nprops">{"location": "tests", "location_unresolved": ["tests"], "section": "14. AI (§4.12, §20B.13)", "spec_section": "§4.12", "status": "IN_PROGRESS", "text": "Evaluation suite (synthetic, arithmetic, injection, leakage, hallucination, malformed, regression, latency/cost)"}</data></node>
    <node id="req:AI-017"><data key="label">AI-017</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:ai", "section": "14. AI (§4.12, §20B.13)", "spec_section": "§6", "status": "TESTED", "text": "`/ai/*` endpoints incl. jobs and preferences"}</data></node>
    <node id="req:ANL-001"><data key="label">ANL-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§4.11", "status": "TESTED", "text": "Daily/weekly/monthly/yearly income &amp; expense; net cash flow; savings amount/rate"}</data></node>
    <node id="req:ANL-002"><data key="label">ANL-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§4.11", "status": "IN_PROGRESS", "text": "Distribution by category/subcategory/merchant/account/payment method"}</data></node>
    <node id="req:ANL-003"><data key="label">ANL-003</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§4.11", "status": "TESTED", "text": "Recurring/subscription cost, budget performance, group/trip/household, refund trends"}</data></node>
    <node id="req:ANL-004"><data key="label">ANL-004</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§4.11", "status": "VERIFIED", "text": "Period comparisons and spending changes"}</data></node>
    <node id="req:ANL-005"><data key="label">ANL-005</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§4.11", "status": "TESTED", "text": "Data coverage / missing sources"}</data></node>
    <node id="req:ANL-006"><data key="label">ANL-006</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics, DOC:METRICS", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§20B.12", "status": "TESTED", "text": "Canonical calculation layer shared by dashboard, reports, AI; metrics documented"}</data></node>
    <node id="req:ANL-007"><data key="label">ANL-007</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:analytics", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§20B.12", "status": "TESTED", "text": "Account balance history; goal progress analytics"}</data></node>
    <node id="req:ANL-008"><data key="label">ANL-008</data><data key="ntype">requirement</data><data key="nprops">{"location": "W, M", "section": "13. Analytics, reports, exports (§4.11, §20B.12)", "spec_section": "§20B.12", "status": "VERIFIED", "text": "Accessible charts with tables, empty states, currency/period labels"}</data></node>
    <node id="req:ANOM-001"><data key="label">ANOM-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:insights", "section": "15. Anomalies &amp; savings (§4.13, §20B.14)", "spec_section": "§4.13", "status": "TESTED", "text": "Detect the 10 listed anomaly kinds"}</data></node>
    <node id="req:ANOM-002"><data key="label">ANOM-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:insights", "section": "15. Anomalies &amp; savings (§4.13, §20B.14)", "spec_section": "§4.13 §20B.14", "status": "TESTED", "text": "Explainable rules with evidence, baseline, min history, confidence"}</data></node>
    <node id="req:ANOM-003"><data key="label">ANOM-003</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:insights", "section": "15. Anomalies &amp; savings (§4.13, §20B.14)", "spec_section": "§4.13", "status": "TESTED", "text": "Labels \"unusual\"/\"possible anomaly\", never fraud"}</data></node>
    <node id="req:ANOM-004"><data key="label">ANOM-004</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:insights", "section": "15. Anomalies &amp; savings (§4.13, §20B.14)", "spec_section": "§4.13 §20B.14", "status": "TESTED", "text": "Dismiss/correct/mark expected/snooze/mute; feedback; no auto-blocking"}</data></node>
    <node id="req:ANOM-005"><data key="label">ANOM-005</data><data key="ntype">requirement</data><data key="nprops">{"location": "tests", "location_unresolved": ["tests"], "section": "15. Anomalies &amp; savings (§4.13, §20B.14)", "spec_section": "§20B.14", "status": "IN_PROGRESS", "text": "Tests: sparse, income change, seasonal, refunds, currency, false positives"}</data></node>
    <node id="req:API-001"><data key="label">API-001</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/httpx", "section": "24. API (§6)", "spec_section": "§6", "status": "TESTED", "text": "`/api/v1`, JSON over HTTPS"}</data></node>
    <node id="req:API-002"><data key="label">API-002</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/httpx", "section": "24. API (§6)", "spec_section": "§6", "status": "TESTED", "text": "Success/error envelopes with request ID"}</data></node>
    <node id="req:API-003"><data key="label">API-003</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/apperr", "section": "24. API (§6)", "spec_section": "§6", "status": "TESTED", "text": "Standard error codes"}</data></node>
    <node id="req:API-004"><data key="label">API-004</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/pagination", "location_unresolved": ["BE:platform/pagination"], "section": "24. API (§6)", "spec_section": "§6", "status": "VERIFIED", "text": "Cursor pagination, sorting, filtering"}</data></node>
    <node id="req:API-005"><data key="label">API-005</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/idempotency", "section": "24. API (§6)", "spec_section": "§6", "status": "TESTED", "text": "Idempotency keys for financial writes"}</data></node>
    <node id="req:API-006"><data key="label">API-006</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform", "section": "24. API (§6)", "spec_section": "§6", "status": "TESTED", "text": "Rate limits, request size limits, timeouts"}</data></node>
    <node id="req:API-007"><data key="label">API-007</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE", "section": "24. API (§6)", "spec_section": "§6", "status": "VERIFIED", "text": "Concurrency/version checks"}</data></node>
    <node id="req:API-008"><data key="label">API-008</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:platform/apperr", "section": "24. API (§6)", "spec_section": "§6", "status": "IMPLEMENTED", "text": "Never return SQL, stack traces, secrets, privileged file URLs"}</data></node>
    <node id="req:API-009"><data key="label">API-009</data><data key="ntype">requirement</data><data key="nprops">{"location": "contracts/, DOC:API", "section": "24. API (§6)", "spec_section": "§6 §1.6", "status": "TESTED", "text": "OpenAPI docs + deprecation policy"}</data></node>
    <node id="req:API-010"><data key="label">API-010</data><data key="ntype">requirement</data><data key="nprops">{"deps": "features", "location": "BE", "section": "24. API (§6)", "spec_section": "§6", "status": "TESTED", "text": "All endpoint families of §6 implemented"}</data></node>
