    <node id="req:TXN-008"><data key="label">TXN-008</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:transactions", "section": "6. Transactions (§4.4, §20B.5, §18)", "spec_section": "§4.4", "status": "IMPLEMENTED", "text": "Bulk category/tag/account update; bulk delete with confirmation"}</data></node>
