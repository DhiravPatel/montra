    <node id="req:TXN-022"><data key="label">TXN-022</data><data key="ntype">requirement</data><data key="nprops">{"deps": "AUTH-019", "location": "BE", "section": "6. Transactions (§4.4, §20B.5, §18)", "spec_section": "§4.4", "status": "IMPLEMENTED", "text": "Optional consented location text"}</data></node>
    <node id="req:TXN-023"><data key="label">TXN-023</data><data key="ntype">requirement</data><data key="nprops">{"deps": "JOB", "location": "BE", "section": "6. Transactions (§4.4, §20B.5, §18)", "spec_section": "§18", "status": "TESTED", "text": "Outbox event on commit → analytics/budget jobs"}</data></node>
