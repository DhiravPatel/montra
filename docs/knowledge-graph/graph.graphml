    <node id="make:api"><data key="label">make api</data><data key="ntype">make_target</data><data key="nprops">{"help": "Run the Go API on :8080", "recipe": ["cd backend &amp;&amp; go run ./cmd/api"]}</data></node>
    <node id="make:build-backend"><data key="label">make build-backend</data><data key="ntype">make_target</data><data key="nprops">{"help": "Build api, worker and migrate binaries", "recipe": ["cd backend &amp;&amp; CGO_ENABLED=0 go build -trimpath -o bin/api ./cmd/api &amp;&amp; CGO_ENABLED=0 go build -trimpath -o bin/worker ./cmd/worker &amp;&amp; CGO_ENABLED=0 go build -trimpath -o bin/migrate ./cmd/migrate"]}</data></node>
    <node id="make:check"><data key="label">make check</data><data key="ntype">make_target</data><data key="nprops">{"help": "Everything CI runs"}</data></node>
    <node id="make:contract"><data key="label">make contract</data><data key="ntype">make_target</data><data key="nprops">{"help": "Regenerate contracts/openapi/montra.v1.json from the Go API", "recipe": ["cd backend &amp;&amp; go run ./cmd/openapi -out ../contracts/openapi/montra.v1.json"]}</data></node>
    <node id="make:contract-check"><data key="label">make contract-check</data><data key="ntype">make_target</data><data key="nprops">{"help": "Fail if the committed contract is out of date", "recipe": ["cd backend &amp;&amp; go run ./cmd/openapi -check -out ../contracts/openapi/montra.v1.json"]}</data></node>
    <node id="make:db-bootstrap"><data key="label">make db-bootstrap</data><data key="ntype">make_target</data><data key="nprops">{"help": "Create Montra roles + montra_dev/montra_test on the EXISTING local PostgreSQL (prints target first)", "recipe": ["./scripts/db/bootstrap.sh"]}</data></node>
    <node id="make:db-reset-dev"><data key="label">make db-reset-dev</data><data key="ntype">make_target</data><data key="nprops">{"help": "DESTRUCTIVE for montra_dev only: drop schema montra and re-migrate (asks for confirmation)", "recipe": ["@read -p \"Type montra_dev to confirm reset of schema montra in montra_dev: \" c; cd backend &amp;&amp; go run ./cmd/migrate reset -confirm $$c"]}</data></node>
    <node id="make:docs"><data key="label">make docs</data><data key="ntype">make_target</data><data key="nprops">{"help": "Regenerate generated docs (error-code tables in docs/API.md, knowledge graph in docs/knowledge-graph)", "recipe": ["python3 scripts/docs/gen_error_codes.py", "python3 scripts/docs/gen_knowledge_graph.py"]}</data></node>
    <node id="make:docs-check"><data key="label">make docs-check</data><data key="ntype">make_target</data><data key="nprops">{"help": "Fail if generated docs are out of date (error codes, knowledge graph + its parser tests)", "recipe": ["python3 scripts/docs/gen_error_codes.py --check", "python3 -B -m unittest scripts/docs/test_gen_knowledge_graph.py", "python3 scripts/docs/gen_knowledge_graph.py --check"]}</data></node>
    <node id="make:e2e"><data key="label">make e2e</data><data key="ntype">make_target</data><data key="nprops">{"help": "Playwright journeys, all three projects (starts Vite on :5199; API via MONTRA_API_PROXY_TARGET, default :8080)", "recipe": ["cd web &amp;&amp; pnpm e2e"]}</data></node>
    <node id="make:e2e-mobile"><data key="label">make e2e-mobile</data><data key="ntype">make_target</data><data key="nprops">{"help": "Flutter integration_test journeys on the running Android emulator against the API on :8080 (keeps the app installed)", "recipe": ["cd mobile &amp;&amp; $(FLUTTER) test integration_test --no-uninstall --dart-define=API_BASE_URL=http://10.0.2.2:8080"]}</data></node>
    <node id="make:fmt"><data key="label">make fmt</data><data key="ntype">make_target</data><data key="nprops">{"help": "Format Go code", "recipe": ["cd backend &amp;&amp; gofmt -w ./cmd ./internal ./tests"]}</data></node>
    <node id="make:fuzz"><data key="label">make fuzz</data><data key="ntype">make_target</data><data key="nprops">{"help": "Short fuzz run for money and split allocation", "recipe": ["cd backend &amp;&amp; go test ./internal/domain/money -run=^$$ -fuzz=FuzzParseFormatRoundTrip -fuzztime=20s", "cd backend &amp;&amp; go test ./internal/domain/split -run=^$$ -fuzz=FuzzByWeights -fuzztime=20s"]}</data></node>
    <node id="make:gen-mobile-api"><data key="label">make gen-mobile-api</data><data key="ntype">make_target</data><data key="nprops">{"help": "Regenerate Dart models from the contract", "recipe": ["cd mobile &amp;&amp; dart run tool/gen_api.dart"]}</data></node>
    <node id="make:gen-web-api"><data key="label">make gen-web-api</data><data key="ntype">make_target</data><data key="nprops">{"help": "Regenerate TypeScript API types from the contract", "recipe": ["cd web &amp;&amp; pnpm gen:api"]}</data></node>
    <node id="make:help"><data key="label">make help</data><data key="ntype">make_target</data><data key="nprops">{"help": "Show this help", "recipe": ["@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = \":.*?## \"}; {printf \"  \\033[36m%-20s\\033[0m %s\\n\", $$1, $$2}'"]}</data></node>
    <node id="make:lint"><data key="label">make lint</data><data key="ntype">make_target</data><data key="nprops">{"help": "Lint Go code", "recipe": ["cd backend &amp;&amp; go vet ./... &amp;&amp; $(GOLANGCI) run ./..."]}</data></node>
    <node id="make:load-test"><data key="label">make load-test</data><data key="ntype">make_target</data><data key="nprops">{"help": "Local load test against the dev API (refuses non-local targets; never production)", "recipe": ["cd backend &amp;&amp; go run ./cmd/loadtest -users 10 -duration 60s -rate 2"]}</data></node>
    <node id="make:migrate"><data key="label">make migrate</data><data key="ntype">make_target</data><data key="nprops">{"help": "Apply migrations to montra_dev (prints target first)", "recipe": ["cd backend &amp;&amp; go run ./cmd/migrate up"]}</data></node>
    <node id="make:migrate-status"><data key="label">make migrate-status</data><data key="ntype">make_target</data><data key="nprops">{"help": "Show migration status for montra_dev", "recipe": ["cd backend &amp;&amp; go run ./cmd/migrate status"]}</data></node>
    <node id="make:migrate-test"><data key="label">make migrate-test</data><data key="ntype">make_target</data><data key="nprops">{"help": "Apply migrations to montra_test", "recipe": ["cd backend &amp;&amp; set -a &amp;&amp; . ./.env.local &amp;&amp; set +a &amp;&amp; go run ./cmd/migrate up -url \"$$TEST_DATABASE_MIGRATION_URL\""]}</data></node>
    <node id="make:mobile"><data key="label">make mobile</data><data key="ntype">make_target</data><data key="nprops">{"help": "Run the Flutter app on the Android emulator (reaches the host API at 10.0.2.2; the app adds /api/v1)", "recipe": ["cd mobile &amp;&amp; $(FLUTTER) run --dart-define=API_BASE_URL=http://10.0.2.2:8080"]}</data></node>
    <node id="make:mobile-analyze"><data key="label">make mobile-analyze</data><data key="ntype">make_target</data><data key="nprops">{"help": "Flutter static analysis", "recipe": ["cd mobile &amp;&amp; $(FLUTTER) analyze"]}</data></node>
    <node id="make:mobile-test"><data key="label">make mobile-test</data><data key="ntype">make_target</data><data key="nprops">{"help": "Flutter tests", "recipe": ["cd mobile &amp;&amp; $(FLUTTER) test"]}</data></node>
    <node id="make:seed"><data key="label">make seed</data><data key="ntype">make_target</data><data key="nprops">{"help": "Load deterministic synthetic seed data into montra_dev", "recipe": ["cd backend &amp;&amp; go run ./cmd/migrate seed"]}</data></node>
    <node id="make:sqlc"><data key="label">make sqlc</data><data key="ntype">make_target</data><data key="nprops">{"help": "Regenerate sqlc query code from backend/internal/store/queries", "recipe": ["cd backend &amp;&amp; $(SQLC) generate"]}</data></node>
    <node id="make:test"><data key="label">make test</data><data key="ntype">make_target</data><data key="nprops">{"help": "All test suites"}</data></node>
    <node id="make:test-backend"><data key="label">make test-backend</data><data key="ntype">make_target</data><data key="nprops">{"help": "Go unit tests (no database)", "recipe": ["cd backend &amp;&amp; go test ./internal/..."]}</data></node>
    <node id="make:test-integration"><data key="label">make test-integration</data><data key="ntype">make_target</data><data key="nprops">{"help": "Go integration + RLS + API tests against montra_test (sequential packages)", "recipe": ["cd backend &amp;&amp; go test -p 1 -count=1 ./tests/... ./internal/..."]}</data></node>
    <node id="make:vuln"><data key="label">make vuln</data><data key="ntype">make_target</data><data key="nprops">{"help": "Dependency vulnerability scan (requires govulncheck)", "recipe": ["cd backend &amp;&amp; go run golang.org/x/vuln/cmd/govulncheck@v1.1.4 ./..."]}</data></node>
    <node id="make:web"><data key="label">make web</data><data key="ntype">make_target</data><data key="nprops">{"help": "Run the React portal on :5173 (proxies /api to :8080)", "recipe": ["cd web &amp;&amp; pnpm dev"]}</data></node>
    <node id="make:web-build"><data key="label">make web-build</data><data key="ntype">make_target</data><data key="nprops">{"help": "Production build of the web portal (no deploy)", "recipe": ["cd web &amp;&amp; pnpm build"]}</data></node>
    <node id="make:web-lint"><data key="label">make web-lint</data><data key="ntype">make_target</data><data key="nprops">{"help": "Web typecheck + lint", "recipe": ["cd web &amp;&amp; pnpm typecheck &amp;&amp; pnpm lint"]}</data></node>
    <node id="make:web-test"><data key="label">make web-test</data><data key="ntype">make_target</data><data key="nprops">{"help": "Web unit tests", "recipe": ["cd web &amp;&amp; pnpm test"]}</data></node>
    <node id="make:worker"><data key="label">make worker</data><data key="ntype">make_target</data><data key="nprops">{"help": "Run the Go worker (jobs, scheduler, outbox)", "recipe": ["cd backend &amp;&amp; go run ./cmd/worker"]}</data></node>
