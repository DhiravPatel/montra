    <node id="req:WEB-005"><data key="label">WEB-005</data><data key="ntype">requirement</data><data key="nprops">{"location": "web/src/shared/components", "section": "25. Clients (§7, §20B.23)", "spec_section": "§7", "status": "TESTED", "text": "Shared design system"}</data></node>
    <node id="req:WEB-006"><data key="label">WEB-006</data><data key="ntype">requirement</data><data key="nprops">{"location": "web", "section": "25. Clients (§7, §20B.23)", "spec_section": "§7", "status": "TESTED", "text": "Loading/empty/error/success/permission states"}</data></node>
    <node id="req:WEB-007"><data key="label">WEB-007</data><data key="ntype">requirement</data><data key="nprops">{"location": "web", "section": "25. Clients (§7, §20B.23)", "spec_section": "§7", "status": "TESTED", "text": "No duplicated financial calcs; never trust client totals"}</data></node>
    <node id="req:WEB-008"><data key="label">WEB-008</data><data key="ntype">requirement</data><data key="nprops">{"location": "web", "section": "25. Clients (§7, §20B.23)", "spec_section": "§7", "status": "VERIFIED", "text": "Safe optimistic updates; duplicate-submit prevention; stale/concurrent edits"}</data></node>
    <node id="req:WEB-009"><data key="label">WEB-009</data><data key="ntype">requirement</data><data key="nprops">{"location": "web", "section": "25. Clients (§7, §20B.23)", "spec_section": "§7 §20B.23", "status": "TESTED", "text": "No secrets/sensitive values in bundles, console, titles, URLs, localStorage"}</data></node>
    <node id="req:WEB-010"><data key="label">WEB-010</data><data key="ntype">requirement</data><data key="nprops">{"location": "web", "section": "25. Clients (§7, §20B.23)", "spec_section": "§7 §16", "status": "TESTED", "text": "Keyboard/screen-reader accessibility; reduced motion"}</data></node>
