    <node id="req:TXN-010"><data key="label">TXN-010</data><data key="ntype">requirement</data><data key="nprops">{"location": "BE:transactions", "section": "6. Transactions (§4.4, §20B.5, §18)", "spec_section": "§4.4", "status": "TESTED", "text": "Sort, cursor pagination, saved filters"}</data></node>
