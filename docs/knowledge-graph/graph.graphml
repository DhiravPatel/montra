    <node id="req:REC-006"><data key="label">REC-006</data><data key="ntype">requirement</data><data key="nprops">{"deps": "JOB", "location": "BE:recurring", "section": "9. Recurring &amp; bills (§4.7, §20B.8)", "spec_section": "§4.7 §20B.8", "status": "TESTED", "text": "Durable idempotent generation, missed-run recovery, retry, no duplicate reminders"}</data></node>
