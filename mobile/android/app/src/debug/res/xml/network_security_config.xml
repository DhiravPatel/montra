<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allow plain HTTP so the app can reach the local Go API
  (http://10.0.2.2:8080 from the emulator, or the host's LAN address from a
  device). Release builds use src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
