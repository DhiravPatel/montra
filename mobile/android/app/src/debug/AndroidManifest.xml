<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <activity android:name=".MainActivity">
            <!--
              Debug builds only: accept the development email links
              (http://localhost:5173/verify-email#token=...) when they are sent
              to this package explicitly, e.g.
                adb shell am start -W -a android.intent.action.VIEW \
                  -d "http://localhost:5173/verify-email#token=TOKEN" app.montra.mobile
              Release builds only claim https links on the configured domain.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:host="localhost" />
                <data android:host="10.0.2.2" />
                <data android:path="/verify-email" />
                <data android:path="/reset-password" />
                <data android:path="/groups/join" />
                <data android:path="/communities/join" />
            </intent-filter>
        </activity>
    </application>
</manifest>
