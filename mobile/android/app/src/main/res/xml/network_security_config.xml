<?xml version="1.0" encoding="utf-8"?>
<!--
  Release and profile builds: HTTPS only, system trust anchors only (user-added
  CAs are not trusted). Debug builds override this file from src/debug/res/xml
  to reach a local development API over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
